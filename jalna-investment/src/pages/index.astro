<script>
(function(){
  var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* section rail */
  var rail=document.getElementById('rail'), ind=document.getElementById('ind'),
      links=Array.prototype.slice.call(rail.querySelectorAll('a')),
      secs=links.map(function(a){ return document.querySelector(a.getAttribute('href')); });

  function move(a){ if(!a) return; ind.style.width=a.offsetWidth+'px'; ind.style.transform='translateX('+a.offsetLeft+'px)'; }
  function setActive(a){
    links.forEach(function(l){ l.classList.toggle('on', l===a); });
    move(a);
    var l=a.offsetLeft, r=l+a.offsetWidth;
    if(l<rail.scrollLeft+12 || r>rail.scrollLeft+rail.clientWidth-12){
      rail.scrollTo({ left:l-24, behavior: reduce?'auto':'smooth' });
    }
  }
  window.addEventListener('load', function(){ move(links[0]); });
  window.addEventListener('resize', function(){ move(rail.querySelector('a.on')||links[0]); });
  links.forEach(function(a){ a.addEventListener('click', function(){ setActive(a); }); });

  if('IntersectionObserver' in window){
    var spy=new IntersectionObserver(function(es){
      es.forEach(function(en){
        if(en.isIntersecting){ var i=secs.indexOf(en.target); if(i>-1) setActive(links[i]); }
      });
    }, { rootMargin:'-45% 0px -50% 0px', threshold:0 });
    secs.forEach(function(s){ if(s) spy.observe(s); });
  }

  /* scroll progress */
  var prog=document.getElementById('prog'), tick=false;
  function onScroll(){
    var h=document.documentElement.scrollHeight-window.innerHeight;
    prog.style.width=(h>0?(window.scrollY/h)*100:0)+'%';
    tick=false;
  }
  window.addEventListener('scroll', function(){ if(!tick){ tick=true; window.requestAnimationFrame(onScroll); } }, { passive:true });

  /* agenda filter */
  var chips=document.querySelectorAll('.chip'), events=document.querySelectorAll('.ev');
  chips.forEach(function(chip){
    chip.addEventListener('click', function(){
      chips.forEach(function(item){ item.classList.toggle('on', item===chip); });
      var filter=chip.dataset.f;
      events.forEach(function(event){ event.classList.toggle('dim', filter!=='all' && event.dataset.k!==filter); });
    });
  });

  /* reveal */
  var items=document.querySelectorAll('.rv');
  if(!('IntersectionObserver' in window) || reduce){
    items.forEach(function(el){ el.classList.add('in'); });
  } else {
    var io=new IntersectionObserver(function(es){
      es.forEach(function(en,i){
        if(en.isIntersecting){
          en.target.style.transitionDelay=(i*80)+'ms';
          en.target.classList.add('in');
          io.unobserve(en.target);
        }
      });
    }, { threshold:.12, rootMargin:'0px 0px -8% 0px' });
    items.forEach(function(el){ io.observe(el); });
  }
  onScroll();
})();
</script>
