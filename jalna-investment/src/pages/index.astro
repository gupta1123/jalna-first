<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="description" content="Meet the government, infrastructure and industry leaders coming together at Jalna Industrial Summit 2026 to advance the MMLP Dry Port and the district's next investment opportunities.">
<meta name="theme-color" content="#093C54">
<link rel="icon" type="image/png" sizes="512x512" href="/industrial-summit/industrial-summit-favicon-transparent.png">
<link rel="shortcut icon" type="image/png" href="/industrial-summit/industrial-summit-favicon-transparent.png">
<link rel="apple-touch-icon" href="/industrial-summit/industrial-summit-favicon-transparent.png">
<title>Jalna Industrial Summit 2026 — Leaders, Invitees &amp; Opportunities</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Tiro+Devanagari+Marathi:ital@0;1&display=swap" rel="stylesheet">

<style is:global>
/* ═════════ TOKENS ═════════ */
:root{
  --paper:      #F5FBFB;
  --paper-deep: #E2F0F2;
  --card:       #FFFFFF;
  --ink:        #093C54;
  --navy:       #0C4A66;
  --navy-deep:  #052C3E;
  --brass:      #0DA1A7;
  --seed:       #2C8F99;
  --steel:      #7FC0C8;

  --i72: rgba(9,60,84,.72);
  --i48: rgba(9,60,84,.48);
  --i16: rgba(9,60,84,.16);
  --i08: rgba(9,60,84,.08);

  --dsp:  "Instrument Serif",Georgia,"Times New Roman",serif;
  --body: "Instrument Serif",Georgia,"Times New Roman",serif;
  --mono: "Instrument Serif",Georgia,"Times New Roman",serif;
  --deva: "Tiro Devanagari Marathi","Instrument Serif",serif;

  --wrap: min(1240px,90vw);
  --pad:  clamp(78px,9.5vw,140px);
  --head: 130px;
}
*,*::before,*::after{ box-sizing:border-box }
html{ -webkit-text-size-adjust:100%; scroll-behavior:smooth }
body{ margin:0; background:var(--paper); color:var(--ink); font:400 17px/1.72 var(--body); -webkit-font-smoothing:antialiased; overflow-x:hidden }
svg,img{ display:block; max-width:100% }
a{ color:inherit }
section[id]{ scroll-margin-top:var(--head) }

/* ═════════ TYPE ═════════ */
h1,h2,h3,h4{ margin:0 }
.h2{ font:400 clamp(34px,4.4vw,62px)/1.04 var(--dsp); letter-spacing:-.018em }
.h2 em{ font-style:italic; color:var(--navy) }
.two-line-title{ font-size:clamp(25px,8vw,62px) }
.two-line-title > span{ display:block; white-space:nowrap }
.h3{ font:400 clamp(21px,1.8vw,26px)/1.2 var(--dsp); letter-spacing:-.012em }
.lede{ font-size:clamp(16px,1.15vw,18px); color:var(--i72); max-width:58ch }
.marathi{ font-family:var(--deva) }
.tag{
  display:inline-flex; align-items:center; gap:12px;
  font:400 11px/1 var(--mono); letter-spacing:.18em; text-transform:uppercase; color:var(--navy);
}
.tag i{ font-style:normal; color:var(--brass) }
.tag::before{ content:""; width:38px; height:1.5px; background:var(--brass); order:-1 }
.tag.inv{ color:var(--brass) }
.tag.inv::before{ background:rgba(245,251,251,.45) }

.wrap{ width:var(--wrap); margin-inline:auto }
.sec{ padding-block:var(--pad); position:relative }

/* ═════════ BUTTONS ═════════ */
.btn{
  display:inline-flex; align-items:center; gap:10px; cursor:pointer; text-decoration:none;
  font:600 14.5px/1 var(--body); letter-spacing:.01em; padding:16px 27px; border-radius:100px;
  border:1.5px solid var(--ink); transition:transform .18s, box-shadow .18s, background .18s, color .18s;
}
.b-navy{ background:var(--navy); border-color:var(--navy); color:var(--paper); box-shadow:4px 4px 0 var(--ink) }
.b-navy:hover{ transform:translate(-2px,-2px); box-shadow:7px 7px 0 var(--ink) }

/* ═════════ HEADER ═════════ */
.prog{ position:fixed; top:0; left:0; height:3px; background:var(--brass); z-index:200; width:0 }
.head{ position:sticky; top:0; z-index:150; background:var(--paper) }
.htop{ display:flex; align-items:center; gap:24px; height:76px }
.logo{ display:flex; align-items:center; gap:13px; text-decoration:none; margin-right:auto }
.head .logo{ position:absolute; left:clamp(20px,2.6vw,52px); top:4px }
.head .logo-img{ display:block; width:185px; height:auto; mix-blend-mode:multiply }
.site-switch{
  flex:none; margin-left:auto; text-decoration:none; padding:9px 14px; border:1.5px solid var(--i16); border-radius:100px;
  font:600 12px/1 var(--body); color:var(--i72); transition:background .18s,color .18s,border-color .18s;
}
.site-switch:hover{ background:var(--ink); border-color:var(--ink); color:var(--paper) }
.when{ font:400 11px/1.7 var(--mono); letter-spacing:.1em; text-transform:uppercase; color:var(--i48); text-align:right }
.when b{ color:var(--ink); font-weight:500 }
.hcta{ padding:13px 22px; font-size:13.5px; box-shadow:3px 3px 0 var(--ink) }
.mobile-actions{ display:none }
.mobile-action{
  min-height:38px; display:flex; align-items:center; justify-content:center; padding:9px 12px;
  border:1.5px solid var(--i16); border-radius:100px; color:var(--i72); text-decoration:none;
  font:600 11px/1 var(--body); text-align:center; white-space:nowrap;
}
.mobile-action.primary{ background:var(--navy); border-color:var(--navy); color:var(--paper); box-shadow:2px 2px 0 var(--ink) }

.railw{ border-top:1px solid var(--i16); border-bottom:1px solid var(--i16); background:var(--paper) }
.rail{ position:relative; display:flex; gap:4px; overflow-x:auto; scrollbar-width:none; padding:9px 0 }
.rail::-webkit-scrollbar{ display:none }
.rail a{
  position:relative; z-index:2; flex:none; text-decoration:none; padding:9px 17px; border-radius:2px;
  font:500 13.5px/1 var(--body); color:var(--i48); white-space:nowrap; display:flex; align-items:center; gap:9px;
  transition:color .28s;
}
.rail a em{ font:400 10px/1 var(--mono); font-style:normal; opacity:.6 }
.rail a:hover{ color:var(--ink) }
.rail a.on{ color:var(--paper) }
.ind{
  position:absolute; z-index:1; top:9px; left:0; height:34px; border-radius:2px; background:var(--navy);
  transition:transform .42s cubic-bezier(.65,.05,.15,1), width .42s cubic-bezier(.65,.05,.15,1); will-change:transform,width;
}

/* ═════════ HERO ═════════ */
.hero{ padding-top:clamp(38px,4.5vw,68px); padding-bottom:0; overflow:hidden }
.hg{ display:grid; grid-template-columns:.92fr 1.08fr; gap:clamp(26px,3.5vw,58px); align-items:center }
.hero h1{ margin:24px 0 0; font-family:var(--dsp); font-weight:400; letter-spacing:-.022em }
.hero .l1{ display:block; font-size:clamp(44px,5.8vw,82px); line-height:1; white-space:nowrap }
.hero .l2{ display:block; font-size:clamp(30px,4.1vw,60px); line-height:1.06; color:var(--navy); letter-spacing:-.02em; margin-top:6px }
.hero .l2 em{ font-style:italic; position:relative; z-index:1 }
.hero .l2 em::after{
  content:""; position:absolute; z-index:-1; inset:auto 0 .07em 0; height:.2em; background:var(--brass);
  opacity:.55; transform:scaleX(0); transform-origin:left; animation:swipe .75s cubic-bezier(.2,.75,.3,1) 1.15s forwards;
}
@keyframes swipe{ to{ transform:scaleX(1) } }
.hero p{ margin:24px 0 0 }
.meta{
  display:flex; flex-wrap:wrap; gap:0; margin-top:38px; border:1.5px solid var(--i16);
  border-radius:2px; background:var(--card); overflow:hidden;
}
.meta div{ padding:15px 20px; flex:1 1 auto; border-right:1.5px solid var(--i16) }
.meta div:last-child{ border-right:0 }
.meta span{ display:block; font:400 9.5px/1 var(--mono); letter-spacing:.2em; text-transform:uppercase; color:var(--i48); margin-bottom:8px }
.meta b{ font:400 19px/1.1 var(--dsp); font-weight:400 }
.hline{ margin-top:26px; font:italic 400 clamp(18px,1.7vw,22px)/1.3 var(--dsp); color:var(--navy) }

/* ═════════ MARQUEE ═════════ */
.marq{ background:var(--ink); color:var(--paper); overflow:hidden }
.marqin{ display:flex; width:max-content; animation:slide 46s linear infinite }
.marq span{ display:flex; align-items:center; gap:32px; padding:0 16px; height:52px; white-space:nowrap;
  font:400 11.5px/1 var(--mono); letter-spacing:.18em; text-transform:uppercase }
.marq span::after{ content:""; width:5px; height:5px; border-radius:50%; background:var(--brass); flex:none }
@keyframes slide{ to{ transform:translateX(-50%) } }

/* ═════════ INTRO ═════════ */
.intro{ display:grid; grid-template-columns:1fr 1.1fr; gap:clamp(30px,5vw,84px); align-items:start }
.intro-l{ position:sticky; top:calc(var(--head) + 26px) }
.intro-b p{ margin:0 0 20px; color:var(--i72) }
.intro-b p.first{ font-size:20px; color:var(--ink); line-height:1.55 }

/* ═════════ INVITEES ═════════ */
.invitees{ background:var(--paper-deep) }
.iv-lead{ display:grid; grid-template-columns:.78fr 1.22fr; gap:clamp(26px,4.2vw,68px); align-items:center }
.iv-top{ max-width:24ch }
.iv-top .lede{ margin-top:20px; max-width:34ch }
.iv-deva{ display:block; margin-top:16px; font-family:var(--deva); font-size:15px; line-height:1.7; color:var(--navy) }

.iv-plan{ margin:0 }
.iv-plan figcaption{ margin-top:12px; text-align:right; font:400 9.5px/1.6 var(--mono);
  letter-spacing:.2em; text-transform:uppercase; color:var(--i48) }

.dig{ list-style:none; margin:clamp(38px,4.6vw,70px) 0 0; padding:0;
  display:grid; grid-template-columns:repeat(4,1fr); gap:clamp(18px,2.4vw,38px) }
.dig li{ padding-top:17px; border-top:1.5px solid var(--ink) }
.dig .rl{ display:flex; align-items:baseline; gap:11px; margin:0;
  font:400 9.5px/1.7 var(--mono); letter-spacing:.2em; text-transform:uppercase; color:var(--i48) }
.dig .no{ color:var(--brass); letter-spacing:.14em }
.dig .nm{ margin:9px 0 0; font:400 clamp(20px,1.75vw,25px)/1.16 var(--dsp); letter-spacing:-.014em }
.dig .nm .sfx{ margin-left:8px; font-size:.44em; letter-spacing:.16em; color:var(--navy); vertical-align:middle }
.dig .of{ margin:8px 0 0; font-size:14.5px; line-height:1.5; color:var(--i72) }
.dig .of b{ font-weight:400; color:var(--brass) }

.iv-also{ margin-top:clamp(50px,6vw,92px) }
.iv-cap{ display:flex; flex-wrap:wrap; align-items:baseline; justify-content:space-between;
  gap:8px 24px; padding-bottom:16px; border-bottom:1.5px solid var(--ink) }
.iv-cap h3{ font:400 clamp(20px,2vw,26px)/1.2 var(--dsp); letter-spacing:-.012em }
.iv-cap span{ font:400 9.5px/1.6 var(--mono); letter-spacing:.2em; text-transform:uppercase; color:var(--i48) }
.co{ list-style:none; margin:clamp(16px,2.2vw,26px) 0 0; padding:0; columns:4; column-gap:clamp(22px,3vw,48px) }
.co li{ break-inside:avoid; padding:10px 0; font:400 17px/1.3 var(--dsp); color:var(--i72) }

.iv-th{ margin-top:clamp(46px,5.4vw,82px); display:grid; grid-template-columns:repeat(3,1fr); gap:clamp(20px,3vw,46px) }
.iv-th div{ padding-top:17px; border-top:1.5px solid var(--ink) }
.iv-th b{ display:block; font:400 clamp(19px,1.9vw,24px)/1.2 var(--dsp); font-weight:400; letter-spacing:-.01em }
.iv-th p{ margin:9px 0 0; font-size:14.5px; line-height:1.55; color:var(--i72) }

.iv-foot{ margin-top:clamp(44px,5.2vw,78px); padding-top:24px; border-top:1px solid var(--i16);
  display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:24px 46px }
.iv-conv{ display:flex; flex-wrap:wrap; gap:18px clamp(28px,4vw,56px) }
.iv-conv p{ margin:0; font:400 9.5px/1.6 var(--mono); letter-spacing:.2em; text-transform:uppercase; color:var(--i48) }
.iv-conv b{ display:block; margin-top:6px; font:italic 400 clamp(19px,1.8vw,23px)/1.2 var(--dsp) }
.iv-sp{ display:flex; align-items:center; gap:14px }
.iv-sp span{ font:400 9px/1.5 var(--mono); letter-spacing:.2em; text-transform:uppercase; color:var(--brass); text-align:right }
.iv-sp img{ width:clamp(112px,12vw,150px); height:auto; mix-blend-mode:multiply }

@media (max-width:1040px){
  .iv-lead{ grid-template-columns:1fr; gap:clamp(24px,4vw,40px) }
  .iv-top{ max-width:32ch }
  .iv-plan figcaption{ text-align:left }
  .dig{ grid-template-columns:repeat(2,1fr) }
  .co{ columns:3 }
  .iv-th{ grid-template-columns:1fr }
}
@media (max-width:760px){
  .dig{ grid-template-columns:1fr; gap:0 }
  .dig li{ padding:17px 0 20px }
  .co{ columns:2 }
  .iv-sp span{ text-align:left }
}
@media (max-width:460px){ .co{ columns:1 } }

/* ═════════ WHY GRID ═════════ */
.band{ background:var(--paper-deep) }
.why{ display:grid; grid-template-columns:repeat(6,1fr); gap:2px; background:var(--i16); border:1.5px solid var(--ink); margin-top:54px }
.wc{ grid-column:span 2; background:var(--card); padding:clamp(26px,2.5vw,36px); transition:background .22s }
.wc:nth-last-child(-n+2){ grid-column:span 3 }
.wc:hover{ background:#fff }
.wc .n{ font:400 10.5px/1 var(--mono); letter-spacing:.16em; color:var(--i48); display:block; margin-bottom:22px }
.wc svg{ width:86px; height:86px; margin-bottom:20px }
.wc h3{ margin-bottom:11px }
.wc p{ margin:0; font-size:15px; color:var(--i72) }

/* ═════════ SECTORS ═════════ */
.sg{ display:grid; grid-template-columns:repeat(3,1fr); gap:clamp(16px,1.8vw,24px); margin-top:54px }
.sc{ border:1.5px solid var(--ink); border-radius:2px; overflow:hidden; background:var(--card); display:flex; flex-direction:column;
  transition:transform .22s, box-shadow .22s }
.sc:hover{ transform:translate(-3px,-4px); box-shadow:8px 9px 0 var(--brass) }
.sc figure{ margin:0; border-bottom:1.5px solid var(--ink); position:relative }
.sc .n{ position:absolute; top:12px; left:14px; font:400 10.5px/1 var(--mono); letter-spacing:.14em; color:var(--i48) }
.sc .txt{ padding:24px clamp(20px,2vw,28px) 28px }
.sc h3{ margin-bottom:11px }
.sc p{ margin:0; font-size:15px; color:var(--i72) }
.sky1{ background:#DBEDF4 } .sky2{ background:#DFF2F3 } .sky3{ background:#E4F5F0 }

/* ═════════ OBJECTIVES ═════════ */
.obj{ background:var(--navy-deep); color:var(--paper) }
.obj .h2{ color:var(--paper) } .obj .h2 em{ color:var(--brass) }
.obj .lede{ color:rgba(245,251,251,.7) }
.olist{ list-style:none; margin:44px 0 0; padding:0; display:grid; grid-template-columns:1fr 1fr; gap:0 clamp(28px,4vw,64px) }
.olist li{ display:grid; grid-template-columns:auto 1fr; gap:16px; align-items:baseline;
  padding:16px 0; border-top:1px solid rgba(245,251,251,.16); font-size:16px }
.olist li i{ font:400 11px/1.6 var(--mono); font-style:normal; color:var(--brass) }

/* ═════════ EXPERIENCE ═════════ */
.eg{ display:grid; grid-template-columns:repeat(3,1fr); gap:clamp(16px,1.8vw,24px); margin-top:54px }
.ec{ border:1.5px solid var(--ink); border-radius:2px; background:var(--card); padding:clamp(24px,2.4vw,32px);
  display:flex; flex-direction:column; transition:transform .22s, box-shadow .22s }
.ec:hover{ transform:translate(-3px,-4px); box-shadow:8px 9px 0 var(--navy) }
.ec svg{ width:52px; height:52px; margin-bottom:22px }
.ec h3{ margin-bottom:10px }
.ec p{ margin:0; font-size:15px; color:var(--i72) }

/* ═════════ AGENDA ═════════ */
.ag-head{ display:flex; justify-content:space-between; align-items:flex-end; gap:32px; flex-wrap:wrap }
.when-card{
  display:flex; align-items:center; gap:20px; border:1.5px solid var(--ink); border-radius:2px;
  background:var(--card); padding:18px 24px 18px 18px; box-shadow:5px 6px 0 var(--navy);
}
.when-card .d{ display:grid; place-items:center; width:64px; height:64px; background:var(--navy); color:var(--paper); font:400 32px/1 var(--dsp); flex:none; border-radius:14px }
.when-card b{ display:block; font:400 20px/1.2 var(--dsp); letter-spacing:-.01em }
.when-card span{ display:block; font:400 11px/1.8 var(--mono); letter-spacing:.1em; color:var(--i48) }
.when-card .ven{ color:var(--brass) }
.stats{ display:grid; grid-template-columns:repeat(4,1fr); gap:2px; background:var(--i16); border:1.5px solid var(--ink); margin-top:44px }
.st{ background:var(--card); padding:22px 24px; display:flex; flex-direction:column; gap:6px }
.st .n{ font:400 clamp(30px,3.2vw,42px)/1 var(--dsp); letter-spacing:-.02em }
.st .l{ font:400 10.5px/1 var(--mono); letter-spacing:.16em; text-transform:uppercase; color:var(--navy) }
.st .s{ font-size:13.5px; color:var(--i48); line-height:1.5 }
.ag-bar{ display:flex; justify-content:space-between; align-items:flex-end; gap:26px; flex-wrap:wrap; margin-top:clamp(38px,4vw,56px) }
.chips{ display:flex; flex-wrap:wrap; gap:8px }
.chip{ display:flex; align-items:center; gap:9px; cursor:pointer; background:var(--card); border:1.5px solid var(--i16); border-radius:100px; padding:10px 15px; font:500 13.5px/1 var(--body); color:var(--i72); transition:.16s }
.chip i{ width:10px; height:10px; border:1px solid var(--ink); flex:none }
.chip:hover{ border-color:rgba(9,60,84,.4); color:var(--ink) }
.chip.on{ background:var(--ink); border-color:var(--ink); color:var(--paper) }
.day{ display:grid; grid-template-columns:76px 1fr; gap:16px; margin-top:clamp(28px,3vw,40px) }
.gutter{ position:relative }
.hm{ position:absolute; right:0; font:400 11.5px/1 var(--mono); letter-spacing:.08em; color:var(--i48) }
.hm.end{ color:var(--brass) }
.track{ position:relative; border-left:1.5px solid var(--ink) }
.hl{ position:absolute; left:0; right:0; height:1px; background:var(--i16) }
.ev{
  position:absolute; left:0; right:0; display:grid; grid-template-columns:72px 1fr auto; gap:18px;
  align-items:start; background:var(--card); border:1.5px solid var(--ink); border-left:5px solid var(--c);
  border-radius:10px; padding:14px 18px; overflow:hidden;
  transition:transform .18s,box-shadow .18s,opacity .3s,filter .3s;
}
.ev:hover{ transform:translate(-3px,-3px); box-shadow:6px 7px 0 var(--c); z-index:3 }
.ev .clock{ font:500 13px/1.4 var(--mono); letter-spacing:.04em; padding-top:1px }
.ev .clock s{ display:block; text-decoration:none; color:var(--i48); font-weight:400; font-size:11.5px }
.ev h3{ margin:0; font:400 19px/1.2 var(--dsp); letter-spacing:-.012em }
.ev .who{ margin:5px 0 0; font-size:13.8px; line-height:1.5; color:var(--i72) }
.ev .xtra{ margin:6px 0 0; font:400 10px/1.4 var(--mono); letter-spacing:.12em; text-transform:uppercase; color:var(--brass) }
.ev .len{ font:400 11px/1.2 var(--mono); letter-spacing:.06em; color:var(--i48); text-align:right }
.ev .len em{ display:block; font-style:normal; font-size:9px; letter-spacing:.16em }
.ev.big{ background:#FAFEFE }
.ev.big h3{ font-size:23px }
.ev.key{ background:rgba(13,161,167,.10) }
.ev.pan{ background:rgba(9,60,84,.07) }
.ev.brk,.ev.arr{ background:var(--paper-deep) }
.ev.short,.ev.tiny{ padding:0 18px; align-items:center }
.ev.short .clock,.ev.tiny .clock{ padding-top:0 }
.ev.short > div,.ev.tiny > div{ display:flex; align-items:baseline; min-width:0 }
.ev.short h3{ font-size:17px }
.ev.tiny h3{ font-size:15.5px }
.ev.short .who,.ev.tiny .who{ margin:0; overflow:hidden; font-size:13px; text-overflow:ellipsis; white-space:nowrap }
.ev.short .who::before,.ev.tiny .who::before{ content:"·"; margin:0 11px; color:var(--i48) }
.ev.short .xtra,.ev.tiny .xtra{ margin:0 0 0 12px }
.ev.dim{ opacity:.24; filter:saturate(.35) }
.ev.dim:hover{ transform:none; box-shadow:none }
.after{ margin-top:clamp(40px,5vw,64px); padding:clamp(26px,3vw,38px); border:1.5px solid var(--ink); border-radius:12px; background:var(--card) }
.after-list{ list-style:none; margin:24px 0 0; padding:0; display:flex; flex-wrap:wrap; gap:10px }
.after-list li{ display:flex; align-items:center; gap:11px; padding:11px 16px; border:1.5px solid var(--i16); border-radius:2px; background:var(--paper); font-size:15px }
.after-list span{ font:400 9.5px/1 var(--mono); letter-spacing:.16em; text-transform:uppercase; color:var(--brass) }
.note{ margin:24px 0 0; padding:14px 16px; border-left:3px solid var(--brass); background:var(--paper-deep); font-size:13.5px; line-height:1.6; color:var(--i72) }

/* ═════════ ATTEND ═════════ */
.att{ display:block }
.who{ display:flex; flex-wrap:wrap; gap:9px; margin-top:34px }
.who span{
  font:500 14px/1 var(--body); padding:11px 17px; border:1.5px solid var(--i16); border-radius:2px;
  background:var(--card); display:flex; align-items:center; gap:9px; transition:border-color .2s, transform .2s;
}
.who span:hover{ border-color:var(--ink); transform:translateY(-2px) }
.who i{ width:6px; height:6px; border-radius:50%; flex:none; font-style:normal }

/* ═════════ PROGRAMME SUMMARY ═════════ */
.programme-summary{ display:grid; grid-template-columns:.75fr 1.25fr; gap:clamp(30px,5vw,76px); align-items:start; margin-top:clamp(38px,5vw,64px) }
.programme-copy{ position:sticky; top:calc(var(--head) + 26px) }
.programme-flow{ list-style:none; margin:0; padding:0; border:1.5px solid var(--ink); background:var(--card) }
.programme-flow li{ display:grid; grid-template-columns:96px 1fr; gap:22px; padding:24px clamp(22px,2.5vw,32px); border-bottom:1px solid var(--i16) }
.programme-flow li:last-child{ border-bottom:0; background:var(--navy-deep); color:var(--paper) }
.programme-flow time{ font:400 11px/1.45 var(--mono); letter-spacing:.1em; text-transform:uppercase; color:var(--brass) }
.programme-flow h3{ font:400 23px/1.15 var(--dsp); margin:0 0 7px }
.programme-flow p{ margin:0; font-size:14.5px; line-height:1.55; color:var(--i72) }
.programme-flow li:last-child p{ color:rgba(245,251,251,.7) }

/* ═════════ SUPPORT ═════════ */
.sup{ background:var(--navy); color:var(--paper) }
.sup .h2{ color:var(--paper) } .sup .h2 em{ color:var(--brass) }
.sup .lede{ color:rgba(245,251,251,.72) }
.sgrid{ display:grid; grid-template-columns:.85fr 1.15fr; gap:clamp(30px,5vw,72px); align-items:start }
.slist{ list-style:none; margin:0; padding:0; display:grid; grid-template-columns:1fr 1fr; gap:0 clamp(24px,3vw,44px) }
.slist li{ display:flex; gap:14px; align-items:flex-start; padding:15px 0;
  border-top:1px solid rgba(245,251,251,.16); font-size:15.5px }
.slist li svg{ flex:none; margin-top:4px }

/* ═════════ VISION ═════════ */
.vis{ background:var(--paper-deep) }
.vg{ display:grid; grid-template-columns:1fr 1fr; gap:clamp(34px,5vw,76px); align-items:center }
.quote{ font:italic 400 clamp(26px,2.9vw,40px)/1.2 var(--dsp); letter-spacing:-.015em; margin:34px 0 0;
  border-left:3px solid var(--brass); padding-left:clamp(20px,2.4vw,32px) }
.quote cite{ display:block; font:400 11px/1 var(--mono); letter-spacing:.18em; text-transform:uppercase;
  color:var(--navy); font-style:normal; margin-top:20px }

/* ═════════ FINAL ═════════ */
.fin{ background:var(--ink); color:var(--paper); text-align:center; position:relative; overflow:hidden }
.fin .h2{ color:var(--paper); font-size:clamp(38px,5.2vw,74px); line-height:1.02; max-width:17ch; margin-inline:auto }
.fin .h2 em{ color:var(--brass) }
.fin p{ color:rgba(245,251,251,.8); max-width:60ch; margin:26px auto 0 }
.fin .sig{ font:italic 400 clamp(21px,2.3vw,30px)/1.3 var(--dsp); color:var(--brass); margin-top:32px }
.blob{ position:absolute; pointer-events:none; opacity:.1 }

/* ═════════ FOOTER ═════════ */
.foot{ background:var(--navy-deep); color:var(--paper); padding:clamp(58px,6vw,86px) 0 34px }
.fg{ display:grid; grid-template-columns:1.5fr 1fr 1fr 1fr; gap:clamp(26px,3.5vw,52px) }
.foot .logo{ display:inline-flex; width:auto; height:auto; overflow:visible }
.foot .logo-img{ display:block; width:270px; height:auto; border-radius:6px }
.foot h4{ font:400 10.5px/1 var(--mono); letter-spacing:.2em; text-transform:uppercase; color:var(--brass); margin-bottom:20px }
.foot ul{ list-style:none; margin:0; padding:0 }
.foot li{ margin-bottom:12px }
.foot a{ font-size:14.5px; color:rgba(245,251,251,.76); text-decoration:none; transition:color .16s }
.foot a:hover{ color:var(--brass) }
.fdesc{ font-size:14.5px; color:rgba(245,251,251,.58); margin:16px 0 0; max-width:32ch }
.flegal{ margin-top:clamp(42px,5vw,66px); padding-top:26px; border-top:1px solid rgba(245,251,251,.14);
  display:flex; flex-wrap:wrap; gap:10px 28px; justify-content:space-between;
  font:400 12px/1.7 var(--mono); color:rgba(245,251,251,.45) }

/* ═════════ MOTION ═════════ */
.rv{ opacity:0; transform:translateY(26px); transition:opacity .75s cubic-bezier(.2,.7,.3,1), transform .75s cubic-bezier(.2,.7,.3,1) }
.rv.in{ opacity:1; transform:none }
.anim{ opacity:0; transform:translateY(22px); animation:rise .85s cubic-bezier(.2,.7,.3,1) forwards }
@keyframes rise{ to{ opacity:1; transform:none } }
.d1{animation-delay:.05s}.d2{animation-delay:.18s}.d3{animation-delay:.31s}.d4{animation-delay:.44s}.d5{animation-delay:.58s}
.al{ opacity:0; animation:rise .95s cubic-bezier(.2,.7,.3,1) forwards }
.l1d{animation-delay:.2s}.l2d{animation-delay:.4s}.l3d{animation-delay:.6s}.l4d{animation-delay:.8s}
.flow-d{ stroke-dasharray:9 13; animation:flow 2.2s linear infinite }
.flowline line{ animation:flow 2.6s linear infinite }
.sc figure svg,.wc svg{ display:block }
.sc figure{ padding:0 }
@keyframes flow{ to{ stroke-dashoffset:-48 } }
.ring{ transform-origin:500px 340px; animation:spin 120s linear infinite }
.ring2{ transform-origin:500px 340px; animation:spin 90s linear infinite reverse }
@keyframes spin{ to{ transform:rotate(360deg) } }
.pulse{ animation:pulse 3.4s ease-in-out infinite }
@keyframes pulse{ 0%,100%{ opacity:.25; r:132 } 50%{ opacity:0; r:186 } }
:focus-visible{ outline:3px solid var(--brass); outline-offset:3px }

/* ═════════ RESPONSIVE ═════════ */
@media (max-width:1040px){
  :root{ --head:126px }
  .hg,.intro,.att,.sgrid,.vg,.programme-summary{ grid-template-columns:1fr }
  .intro-l{ position:static }
  .programme-copy{ position:static }
  .why,.sg,.eg{ grid-template-columns:repeat(2,1fr) }
  .why .wc{ grid-column:auto }
  .why .wc:last-child{ grid-column:1 / -1 }
  .when,.hcta{ display:none }
  .fg{ grid-template-columns:1fr 1fr }
  .stats{ grid-template-columns:1fr 1fr }
  .day{ grid-template-columns:1fr; gap:0 }
  .gutter{ display:none }
  .track{ height:auto !important; border-left:0 }
  .hl{ display:none }
  .ev{ position:static !important; height:auto !important; margin-bottom:10px }
}
@media (max-width:760px){
  body{ font-size:16px }
  :root{ --head:170px }
  .why,.sg,.eg,.fg{ grid-template-columns:1fr }
  .why .wc:last-child{ grid-column:auto }
  .olist,.slist{ grid-template-columns:1fr }
  .hero .l1{ font-size:clamp(40px,12vw,64px); white-space:normal }
  .meta div{ flex:1 1 100%; border-right:0; border-bottom:1.5px solid var(--i16) }
  .meta div:last-child{ border-bottom:0 }
  .btn{ padding:15px 22px }
  .htop{ height:68px }
  .head .logo{ left:18px; top:5px }
  .head .logo-img{ width:165px }
  .foot .logo-img{ width:245px }
  .htop > .site-switch,.htop > .hcta{ display:none }
  .mobile-actions{ display:grid; grid-template-columns:1fr 1fr; gap:8px; padding-bottom:9px }
  .stats{ grid-template-columns:1fr }
  .ev{ grid-template-columns:64px 1fr; gap:14px }
  .ev .len{ display:none }
  .when-card{ width:100% }
  .programme-flow li{ grid-template-columns:1fr; gap:9px }
}
@media (prefers-reduced-motion:reduce){
  *,*::before,*::after{ animation:none !important; transition-duration:.01ms !important }
  html{ scroll-behavior:auto }
  .rv,.anim,.al{ opacity:1; transform:none }
  .hero .l2 em::after{ transform:scaleX(1) }
}
</style>
