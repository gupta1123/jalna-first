---
import '../styles/global.css';

const opportunities = [
  { tag: 'AGRI', title: 'Seeds & Agri-Biotech', text: 'Seed processing, storage, packaging, research and agricultural innovation.' },
  { tag: 'INDUSTRY', title: 'Steel & Engineering', text: 'Value-added steel, fabrication, industrial machinery and engineering components.' },
  { tag: 'FOOD', title: 'Agro & Food Processing', text: 'Pulses, oilseeds, cotton, packaged foods, cold-chain and export-led processing.' },
  { tag: 'LOGISTICS', title: 'Logistics & Warehousing', text: 'Freight, storage, distribution, container services and export infrastructure.' },
  { tag: 'AUTO', title: 'Automotive & Allied', text: 'Bearings, metal components, supply-chain services and future manufacturing.' },
  { tag: 'MSME', title: 'Enterprise & Technology', text: 'Automation, industrial services, clean technology and local supplier growth.' },
];

const summitSteps = [
  ['01', 'Discover', 'Understand Jalna’s industrial base, emerging infrastructure and investible sectors.'],
  ['02', 'Connect', 'Meet decision-makers, local industry, institutions and potential business partners.'],
  ['03', 'Enable', 'Explore land, policy, facilitation, talent and supply-chain requirements.'],
  ['04', 'Invest', 'Move from early interest to partnerships, proposals and long-term projects.'],
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Jalna Investment connects investors, industry and government around Jalna’s next chapter of economic growth." />
    <meta name="theme-color" content="#071924" />
    <link rel="icon" href="/favicon.ico" />
    <title>Jalna Investment — Invest in What’s Next</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="#top" aria-label="Jalna Investment home">
        <span class="brand-symbol" aria-hidden="true">JI</span>
        <span class="brand-copy"><strong>JALNA</strong><small>INVESTMENT</small></span>
      </a>
      <nav aria-label="Primary navigation">
        <a href="/">My Jalna</a>
        <a href="#why">Why Jalna</a>
        <a href="#sectors">Sectors</a>
        <a href="#summit">Summit</a>
        <a class="nav-cta" href="#register">Register interest <span aria-hidden="true">↗</span></a>
      </nav>
    </header>

    <main id="top">
      <section class="hero">
        <div class="hero-grid" aria-hidden="true"></div>
        <div class="hero-copy">
          <div class="edition"><span>JALNA INVESTMENT SUMMIT</span><strong>2026</strong></div>
          <h1>Jalna rising.<br /><em>Invest in what’s next.</em></h1>
          <p>
            Where industrial capability, emerging logistics and entrepreneurial ambition come together to build the next growth engine of Marathwada.
          </p>
          <div class="hero-actions">
            <a class="button button-gold" href="#register">Register your interest <span aria-hidden="true">↗</span></a>
            <a class="outline-link" href="#why">Explore the opportunity <span aria-hidden="true">↓</span></a>
          </div>
        </div>

        <div class="hero-orbit" aria-hidden="true">
          <div class="orbit orbit-one"><span></span></div>
          <div class="orbit orbit-two"><span></span></div>
          <div class="orbit orbit-three"></div>
          <div class="orbit-center">JLN</div>
          <div class="orbit-note note-one"><span>01</span> Industry</div>
          <div class="orbit-note note-two"><span>02</span> Logistics</div>
          <div class="orbit-note note-three"><span>03</span> Exports</div>
        </div>

        <div class="event-bar">
          <div><small>Location</small><strong>Jalna, Maharashtra</strong></div>
          <div><small>Event date</small><strong>Announcing soon</strong></div>
          <div><small>Built for</small><strong>Investors · Industry · Enterprise</strong></div>
        </div>
      </section>

      <section class="intro section-shell" id="why">
        <div class="section-label">01 / The opportunity</div>
        <div class="intro-grid">
          <h2>Built on industry.<br />Ready for acceleration.</h2>
          <div class="intro-copy">
            <p class="lead">Jalna is where an established manufacturing culture meets a new logistics and export opportunity.</p>
            <p>
              A strong base in seeds, steel, engineering and agro-industries has already shaped the district’s economy. Emerging freight infrastructure, regional connectivity and an experienced business community can unlock its next stage of growth.
            </p>
          </div>
        </div>
        <div class="advantage-grid">
          <article><span>01</span><h3>Industrial depth</h3><p>Decades of experience across manufacturing, agriculture and enterprise.</p></article>
          <article><span>02</span><h3>Logistics momentum</h3><p>An emerging multimodal ecosystem supporting industry and exports.</p></article>
          <article><span>03</span><h3>Strategic location</h3><p>Positioned to serve markets across Maharashtra and beyond.</p></article>
          <article><span>04</span><h3>Local capability</h3><p>Entrepreneurs, suppliers, institutions and a workforce ready to grow.</p></article>
        </div>
      </section>

      <section class="sectors" id="sectors">
        <div class="section-shell">
          <div class="section-heading">
            <div>
              <div class="section-label light">02 / Investible sectors</div>
              <h2>Opportunity across<br />the value chain.</h2>
            </div>
            <p>Six sectors where Jalna’s existing strengths and future infrastructure create room for meaningful investment.</p>
          </div>
          <div class="sector-grid">
            {opportunities.map((item, index) => (
              <article>
                <div class="sector-index">0{index + 1}</div>
                <span class="sector-tag">{item.tag}</span>
                <h3>{item.title}</h3>
                <p>{item.text}</p>
                <span class="sector-arrow" aria-hidden="true">↗</span>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="connector section-shell">
        <div class="connector-map" aria-hidden="true">
          <span class="route route-one"></span><span class="route route-two"></span><span class="route route-three"></span>
          <span class="node node-a"></span><span class="node node-b"></span><span class="node node-c"></span><span class="node node-d"></span>
          <strong>JALNA</strong>
        </div>
        <div class="connector-copy">
          <div class="section-label">03 / Connected for growth</div>
          <h2>From the factory floor to the global market.</h2>
          <p>
            The proposed Multi-Modal Logistics Park is envisioned as a regional dry-port and freight hub—supporting more efficient movement for steel, seeds, cotton, agricultural produce and allied industries.
          </p>
          <a href="#register">Discuss a logistics opportunity <span aria-hidden="true">→</span></a>
        </div>
      </section>

      <section class="summit" id="summit">
        <div class="section-shell summit-shell">
          <div class="summit-intro">
            <div class="section-label light">04 / The summit</div>
            <h2>One room.<br />The right conversations.</h2>
            <p>
              A focused platform connecting capital, enterprise, infrastructure, policy and local capability—designed to help promising conversations move toward action.
            </p>
          </div>
          <div class="summit-steps">
            {summitSteps.map((step) => (
              <article>
                <span>{step[0]}</span>
                <h3>{step[1]}</h3>
                <p>{step[2]}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="audience section-shell" id="invitees">
        <div class="section-label">05 / Key Invitees & Sponsors</div>
        <h2>Built for leaders<br />who build.</h2>
        <div class="sponsors-grid">
          <div class="sponsor-card">
            <span class="sponsor-badge">Main Sponsor</span>
            <div class="sponsor-logo-wrap">
              <img src="/Sponsor.png" alt="Vikas Group of Companies Logo" class="sponsor-logo" />
            </div>
            <p class="sponsor-name">Vikas Group of Companies</p>
          </div>
          <div class="sponsor-card">
            <span class="sponsor-badge">Summit Initiative</span>
            <div class="sponsor-logo-wrap">
              <img src="/industrailsummitlogo.png" alt="Jalna First Industrial Summit 2026 Logo" class="sponsor-logo" />
            </div>
            <p class="sponsor-name">Industrial Summit 2026</p>
          </div>
        </div>
        <div class="audience-row">
          <span>Investors</span><span>Manufacturers</span><span>MSMEs</span><span>Exporters</span><span>Logistics leaders</span><span>Financial institutions</span><span>Technology partners</span><span>Policy makers</span>
        </div>
      </section>

      <section class="register" id="register">
        <div class="register-grid" aria-hidden="true"></div>
        <div class="register-copy">
          <p>JALNA INVESTMENT SUMMIT 2026</p>
          <h2>The opportunity is here.<br />The time to build is now.</h2>
          <span>Event programme and registration details will be announced shortly.</span>
          <a class="button button-light" href="https://www.instagram.com/jalnafirstcf/">Follow summit updates <span aria-hidden="true">↗</span></a>
        </div>
      </section>
    </main>

    <footer>
      <a class="brand" href="#top">
        <span class="brand-symbol" aria-hidden="true">JI</span>
        <span class="brand-copy"><strong>JALNA</strong><small>INVESTMENT</small></span>
      </a>
      <p>Connect. Collaborate. Invest. Grow.</p>
      <p>Jalna, Maharashtra · 2026</p>
    </footer>
  </body>
</html>
