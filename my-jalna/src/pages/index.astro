    </div>
  </div>
</footer>

<button class="top" id="top" aria-label="Back to top">
  <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true"><path d="M9 15V3M3.5 8.5 9 3l5.5 5.5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
</button>

<script>
(function(){
  var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* ── section rail: sliding indicator + scroll-spy ── */
  var rail = document.getElementById('rail'),
      ind  = document.getElementById('ind'),
      links = Array.prototype.slice.call(rail.querySelectorAll('a')),
      secs  = links.map(function(a){ return document.querySelector(a.getAttribute('href')); });

  function move(a){
    if(!a) return;
    ind.style.width = a.offsetWidth + 'px';
    ind.style.transform = 'translateX(' + a.offsetLeft + 'px)';
  }
  function setActive(a){
    links.forEach(function(l){ l.classList.toggle('on', l === a); });
    move(a);
    // keep the active chip in view on narrow screens
    var l = a.offsetLeft, r = l + a.offsetWidth;
    if(l < rail.scrollLeft + 12 || r > rail.scrollLeft + rail.clientWidth - 12){
      rail.scrollTo({ left: l - 24, behavior: reduce ? 'auto' : 'smooth' });
    }
  }
  window.addEventListener('load', function(){ move(links[0]); });
  window.addEventListener('resize', function(){
    var cur = rail.querySelector('a.on'); move(cur || links[0]);
  });

  links.forEach(function(a){
    a.addEventListener('click', function(){ setActive(a); });
  });

  if('IntersectionObserver' in window){
    var spy = new IntersectionObserver(function(entries){
      entries.forEach(function(en){
        if(en.isIntersecting){
          var i = secs.indexOf(en.target);
          if(i > -1) setActive(links[i]);
        }
      });
    }, { rootMargin: '-45% 0px -50% 0px', threshold: 0 });
    secs.forEach(function(s){ if(s) spy.observe(s); });
  }

  /* ── scroll progress ── */
  var prog = document.getElementById('prog'), topBtn = document.getElementById('top'), tick = false;
  function onScroll(){
    var h = document.documentElement.scrollHeight - window.innerHeight;
    prog.style.width = (h > 0 ? (window.scrollY / h) * 100 : 0) + '%';
    topBtn.classList.toggle('show', window.scrollY > 700);
    parallax();
    tick = false;
  }
  window.addEventListener('scroll', function(){
    if(!tick){ tick = true; window.requestAnimationFrame(onScroll); }
  }, { passive: true });

  topBtn.addEventListener('click', function(){
    window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
    setActive(links[0]);
  });

  /* ── hero parallax (scroll + pointer) ── */
  var layers = Array.prototype.slice.call(document.querySelectorAll('.plx')), mx = 0, my = 0;
  function parallax(){
    if(reduce || !layers.length) return;
    var y = window.scrollY;
    layers.forEach(function(el){
      var d = parseFloat(el.dataset.d) || 0;
      el.style.transform = 'translate3d(' + (mx * d * 42) + 'px,' + (y * d * -0.35 + my * d * 22) + 'px,0)';
    });
  }
  if(!reduce && window.matchMedia('(pointer:fine)').matches){
    window.addEventListener('mousemove', function(e){
      mx = (e.clientX / window.innerWidth  - .5) * 2;
      my = (e.clientY / window.innerHeight - .5) * 2;
      window.requestAnimationFrame(parallax);
    }, { passive: true });
  }

  /* ── scroll reveal ── */
  var items = document.querySelectorAll('.rv');
  if(!('IntersectionObserver' in window) || reduce){
    items.forEach(function(el){ el.classList.add('in'); });
  } else {
    var io = new IntersectionObserver(function(entries){
      entries.forEach(function(en, i){
        if(en.isIntersecting){
          en.target.style.transitionDelay = (i * 80) + 'ms';
          en.target.classList.add('in');
          io.unobserve(en.target);
        }
      });
    }, { threshold: .12, rootMargin: '0px 0px -8% 0px' });
    items.forEach(function(el){ io.observe(el); });
  }
  onScroll();
})();
</script>
</body>
</html>
