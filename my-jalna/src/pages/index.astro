  function move(a){ if(!a) return; ind.style.width=a.offsetWidth+"px"; ind.style.transform="translateX("+a.offsetLeft+"px)"; }
  function setActive(a){
    links.forEach(function(l){ l.classList.toggle("on", l===a); });
    move(a);
    var l=a.offsetLeft, r=l+a.offsetWidth;
    if(l<rail.scrollLeft+12 || r>rail.scrollLeft+rail.clientWidth-12)
      rail.scrollTo({left:l-24, behavior:reduce?"auto":"smooth"});
  }
  window.addEventListener("load", function(){ move(links[0]); });
  window.addEventListener("resize", function(){ move(rail.querySelector("a.on")||links[0]); });
  links.forEach(function(a){ a.addEventListener("click", function(){ setActive(a); }); });
  if("IntersectionObserver" in window){
    var spy=new IntersectionObserver(function(es){
      es.forEach(function(en){ if(en.isIntersecting){ var i=secs.indexOf(en.target); if(i>-1) setActive(links[i]); } });
    },{rootMargin:"-45% 0px -50% 0px",threshold:0});
    secs.forEach(function(s){ if(s) spy.observe(s); });
  }

  /* About JFCF focus-area tabs */
  var aboutTabs=Array.prototype.slice.call(document.querySelectorAll('.pills [role="tab"]')),
      aboutPanels=Array.prototype.slice.call(document.querySelectorAll('.about-panel'));
  function selectAbout(tab){
    var panelId=tab.getAttribute('aria-controls');
    aboutTabs.forEach(function(t){
      var active=t===tab;
      t.classList.toggle('on',active);
      t.setAttribute('aria-selected',active);
      t.tabIndex=active?0:-1;
    });
    aboutPanels.forEach(function(panel){ panel.hidden=panel.id!==panelId; });
  }
  aboutTabs.forEach(function(tab,index){
    tab.addEventListener('click',function(){ selectAbout(tab); });
    tab.addEventListener('keydown',function(event){
      var next=index;
      if(event.key==='ArrowRight') next=(index+1)%aboutTabs.length;
      else if(event.key==='ArrowLeft') next=(index-1+aboutTabs.length)%aboutTabs.length;
      else if(event.key==='Home') next=0;
      else if(event.key==='End') next=aboutTabs.length-1;
      else return;
      event.preventDefault();
      selectAbout(aboutTabs[next]);
      aboutTabs[next].focus();
    });
  });
  if(aboutTabs.length) selectAbout(aboutTabs[0]);

  /* accordion */
  var items=document.querySelectorAll(".ai");
  function setPanel(it, open){
    var p=it.querySelector(".ap"), b=it.querySelector(".ah");
    it.classList.toggle("on", open);
    b.setAttribute("aria-expanded", open);
    p.style.maxHeight = open ? p.scrollHeight + "px" : "0px";
  }
  items.forEach(function(it){
    it.querySelector(".ah").addEventListener("click", function(){
      var open = !it.classList.contains("on");
      items.forEach(function(o){ setPanel(o, false); });
      if(open) setPanel(it, true);
    });
  });
  setPanel(items[0], true);
  window.addEventListener("resize", function(){
    items.forEach(function(it){ if(it.classList.contains("on")) setPanel(it, true); });
  });


  /* hero parallax — scroll + pointer */
  var layers = Array.prototype.slice.call(document.querySelectorAll(".plx")), mx = 0, my = 0;
  function parallax(){
    if(reduce || !layers.length) return;
    var y = window.scrollY;
    layers.forEach(function(el){
      var d = parseFloat(el.dataset.d) || 0;
      el.style.transform = "translate3d(" + (mx*d*42) + "px," + (y*d*-0.35 + my*d*22) + "px,0)";
    });
  }
  if(!reduce && window.matchMedia("(pointer:fine)").matches){
    window.addEventListener("mousemove", function(e){
      mx = (e.clientX/window.innerWidth - .5) * 2;
      my = (e.clientY/window.innerHeight - .5) * 2;
      requestAnimationFrame(parallax);
    }, {passive:true});
  }

  /* progress + top */
  var prog=document.getElementById("prog"), topBtn=document.getElementById("top"), tick=false;
  function onScroll(){
    var h=document.documentElement.scrollHeight-window.innerHeight;
    prog.style.width=(h>0?(window.scrollY/h)*100:0)+"%";
    topBtn.classList.toggle("show", window.scrollY>760);
    if(window.scrollY<80) setActive(links[0]);
    parallax();
    tick=false;
  }
  window.addEventListener("scroll", function(){ if(!tick){ tick=true; requestAnimationFrame(onScroll); } }, {passive:true});
  topBtn.addEventListener("click", function(){ window.scrollTo({top:0,behavior:reduce?"auto":"smooth"}); setActive(links[0]); });

  /* reveal */
  var rvs=document.querySelectorAll(".rv");
  if(!("IntersectionObserver" in window) || reduce){ rvs.forEach(function(e){ e.classList.add("in"); }); }
  else {
    var io=new IntersectionObserver(function(es){
      es.forEach(function(en,i){
        if(en.isIntersecting){ en.target.style.transitionDelay=(i*80)+"ms"; en.target.classList.add("in"); io.unobserve(en.target); }
      });
    },{threshold:.12,rootMargin:"0px 0px -8% 0px"});
    rvs.forEach(function(e){ io.observe(e); });
  }
  onScroll();
})();
</script>
</body>
</html>
