<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="description" content="Jalna First Citizen Forum brings citizens, businesses, institutions and authorities together for civic awareness, collaboration and positive action in Jalna.">
<meta name="theme-color" content="#093C54">
<link rel="icon" type="image/png" sizes="256x256" href="/JFfavicon.png">
<link rel="apple-touch-icon" href="/JFfavicon.png">
<title>Jalna First Citizen Forum — A Collective Vision for a Progressive City</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Tiro+Devanagari+Marathi:ital@0;1&display=swap" rel="stylesheet">

<style is:global>
/* ═══════════ BRAND TOKENS — sampled from the JFCF logo ═══════════ */
:root{
  --navy:#093C54;  --navy-8:#0C4A66;  --navy-6:#166080;
  --teal:#0DA1A7;  --teal-7:#0B8A90;  --teal-4:#48B8BD;
  --teal-3:#71C8CC; --teal-2:#99D7DA; --teal-1:#C2E7E9; --teal-05:#D6EFF0;
  --mist:#EFF9F9;  --paper:#F5FBFB;  --white:#FFFFFF;

  --n72:rgba(9,60,84,.72); --n56:rgba(9,60,84,.56); --n40:rgba(9,60,84,.40);
  --n16:rgba(9,60,84,.16); --n08:rgba(9,60,84,.08);

  --dsp:"Instrument Serif",Georgia,serif;
  --body:"Instrument Serif",Georgia,serif;
  --mono:"Instrument Serif",Georgia,serif;
  --deva:"Tiro Devanagari Marathi","Instrument Serif",serif;

  --wrap:min(1200px,90vw);
  --pad:clamp(76px,9vw,132px);
  --head:128px;
  --r:16px;
}
*,*::before,*::after{box-sizing:border-box}
html{-webkit-text-size-adjust:100%;scroll-behavior:smooth}
body{margin:0;background:var(--paper);color:var(--navy);font:400 17px/1.72 var(--body);
  -webkit-font-smoothing:antialiased;overflow-x:hidden}
svg,img{display:block;max-width:100%}
a{color:inherit}
section[id]{scroll-margin-top:var(--head)}

/* ═══════════ TYPE ═══════════ */
h1,h2,h3,h4{margin:0}
.h2{font:400 clamp(33px,4.3vw,60px)/1.05 var(--dsp);letter-spacing:-.018em}
.h2 em{font-style:italic;color:var(--teal)}
.two-line-title{font-size:clamp(24px,7.8vw,60px)}
.two-line-title > span{display:block;white-space:nowrap}
.h3{font:400 clamp(20px,1.8vw,25px)/1.22 var(--dsp);letter-spacing:-.012em}
.lede{font-size:clamp(16px,1.15vw,18.5px);color:var(--n72);max-width:58ch}
.marathi{font-family:var(--deva)}
.tag{display:inline-flex;align-items:center;gap:12px;font:400 11px/1 var(--mono);
  letter-spacing:.2em;text-transform:uppercase;color:var(--teal-7)}
.tag::before{content:"";width:32px;height:2px;border-radius:2px;background:var(--teal);order:-1}
.tag i{font-style:normal;color:var(--n40)}
.tag.inv{color:var(--teal-2)}
.tag.inv::before{background:var(--teal-3)}

.wrap{width:var(--wrap);margin-inline:auto}
.sec{padding-block:var(--pad);position:relative}

/* ═══════════ BUTTONS ═══════════ */
.btn{display:inline-flex;align-items:center;gap:10px;cursor:pointer;text-decoration:none;
  font:600 14.5px/1 var(--body);padding:16px 28px;border-radius:100px;border:2px solid var(--navy);
  transition:transform .18s,box-shadow .18s,background .18s,color .18s}
.btn svg{transition:transform .18s}
.btn:hover svg{transform:translateX(4px)}
.b-teal{background:var(--teal);border-color:var(--teal);color:#fff;box-shadow:0 4px 0 var(--navy)}
.b-teal:hover{transform:translateY(-3px);box-shadow:0 7px 0 var(--navy)}
.b-navy{background:var(--navy);border-color:var(--navy);color:#fff;box-shadow:0 4px 0 var(--teal)}
.b-navy:hover{transform:translateY(-3px);box-shadow:0 7px 0 var(--teal)}
.b-line{background:transparent;color:var(--navy)}
.b-line:hover{background:var(--navy);color:#fff}
.b-white{background:#fff;border-color:#fff;color:var(--navy)}
.b-white:hover{transform:translateY(-3px)}
.b-linew{background:transparent;border-color:rgba(255,255,255,.5);color:#fff}
.b-linew:hover{background:#fff;color:var(--navy);border-color:#fff}

/* ═══════════ HEADER ═══════════ */
.prog{position:fixed;top:0;left:0;height:3px;background:var(--teal);z-index:200;width:0}
.head{position:sticky;top:0;z-index:150;background:var(--paper)}
.htop{display:flex;align-items:center;gap:24px;height:76px}
.logo{display:flex;align-items:center;gap:13px;text-decoration:none;margin-right:auto}
.head .logo{position:absolute;left:clamp(20px,2.6vw,52px);top:6px;width:166px;height:68px;overflow:hidden;contain:paint;flex:none;background:url('/JFlogo.png') left top/100% auto no-repeat}
.head .logo-img{display:none}
.site-switch{flex:none;margin-left:auto;text-decoration:none;padding:11px 18px;border:1.5px solid var(--n16);border-radius:100px;
  font:600 12px/1 var(--body);color:var(--n72);transition:background .18s,color .18s,border-color .18s}
.site-switch:hover{background:var(--navy);border-color:var(--navy);color:#fff}
.hcta{padding:12px 22px;font-size:13.5px}
.mobile-actions{display:none}
.railw{border-top:1px solid var(--n16);border-bottom:1px solid var(--n16);background:var(--paper)}
.rail{position:relative;display:flex;gap:4px;overflow-x:auto;scrollbar-width:none;padding:9px 0}
.rail::-webkit-scrollbar{display:none}
.rail a{position:relative;z-index:2;flex:none;text-decoration:none;padding:9px 17px;border-radius:100px;
  font:500 13.5px/1 var(--body);color:var(--n56);white-space:nowrap;display:flex;align-items:center;gap:9px;
  transition:color .28s}
.rail a em{font:400 10px/1 var(--mono);font-style:normal;opacity:.65}
.rail a:hover{color:var(--navy)}
.rail a.on{color:#fff}
.ind{position:absolute;z-index:1;top:9px;left:0;height:34px;border-radius:100px;background:var(--navy);
  transition:transform .42s cubic-bezier(.65,.05,.15,1),width .42s cubic-bezier(.65,.05,.15,1)}

/* ═══════════ HERO ═══════════ */
.hero{padding-top:clamp(40px,5vw,72px);padding-bottom:0;overflow:hidden}
.hg{display:grid;grid-template-columns:1fr 1.34fr;gap:clamp(24px,3vw,46px);align-items:center}
.hg>div:last-child{margin-right:-5vw}
.hg>div:last-child :is(svg,img){width:100%;height:auto}
.hero h1{margin:24px 0 0;font-family:var(--dsp);font-weight:400;letter-spacing:-.024em}
.hero .l1{display:block;font-size:clamp(50px,7.2vw,104px);line-height:.96}
.hero .l2{display:block;font-size:clamp(27px,3.5vw,50px);line-height:1.1;color:var(--teal);
  letter-spacing:-.02em;margin-top:6px}
.hero .l2 em{font-style:italic;position:relative;z-index:1}
.hero .l2 em::after{content:"";position:absolute;z-index:-1;inset:auto 0 .07em 0;height:.22em;
  border-radius:100px;background:var(--teal-2);transform:scaleX(0);transform-origin:left;
  animation:swipe .8s cubic-bezier(.2,.75,.3,1) 1.1s forwards}
@keyframes swipe{to{transform:scaleX(1)}}
.hero p{margin:24px 0 0}
.hero-purpose{max-width:59ch;color:var(--n72);font-size:clamp(15px,1.15vw,18px);line-height:1.65}
.hero-purpose em{color:var(--teal-7);font-style:normal;font-weight:500}
.hmr{margin-top:22px;padding-left:20px;border-left:3px solid var(--teal);border-radius:2px;
  font-size:clamp(17px,1.5vw,20px);max-width:36ch}
.hmr b{color:var(--teal-7);font-weight:400;font-style:italic}

/* ═══════════ TICKER ═══════════ */
.marq{background:var(--navy);color:#fff;overflow:hidden}
.marqin{display:flex;width:max-content;animation:slide 44s linear infinite}
.marq span{display:flex;align-items:center;gap:30px;padding:0 15px;height:54px;white-space:nowrap;
  font:400 11.5px/1 var(--mono);letter-spacing:.18em;text-transform:uppercase;color:var(--teal-2)}
.marq span::after{content:"";width:6px;height:6px;border-radius:50%;background:var(--teal);flex:none}
.marq .mr{font-family:var(--deva);letter-spacing:.02em;text-transform:none;font-size:17px;color:#fff}
@keyframes slide{to{transform:translateX(-50%)}}

/* ═══════════ ABOUT ═══════════ */
.ab{display:grid;grid-template-columns:.92fr 1.08fr;gap:clamp(30px,5vw,80px);align-items:start}
.ab-l{position:sticky;top:calc(var(--head) + 26px)}
.ab-b p{margin:0 0 20px;color:var(--n72)}
.ab-b p.first{font-size:20.5px;color:var(--navy);line-height:1.55}
.pills{display:flex;flex-wrap:wrap;gap:9px;margin-top:30px}
.pill{font:500 13.5px/1 var(--body);padding:11px 18px;border-radius:100px;background:var(--white);
  border:1.5px solid var(--n16);display:flex;align-items:center;gap:9px;color:var(--navy);cursor:pointer;
  transition:background .18s,color .18s,border-color .18s,transform .18s}
.pill i{width:8px;height:8px;border-radius:50%;flex:none;font-style:normal;background:var(--teal)}
.pill:hover{border-color:var(--teal);transform:translateY(-2px)}
.pill.on{background:var(--navy);border-color:var(--navy);color:#fff}
.pill.on i{background:var(--teal-3)}
.about-panels{margin-top:18px}
.about-panel{padding:22px 24px;border:1.5px solid var(--n16);border-left:4px solid var(--teal);
  border-radius:0 14px 14px 0;background:var(--mist);animation:panel-in .24s ease both}
.about-panel[hidden]{display:none}
.about-panel h3{margin:0 0 8px;font:400 25px/1.15 var(--dsp)}
.about-panel p{margin:0;color:var(--n72)}
.about-panel ul{margin:15px 0 0;padding:0;list-style:none;display:grid;gap:8px}
.about-panel li{position:relative;padding-left:18px;font-size:14.5px;line-height:1.5;color:var(--n72)}
.about-panel li::before{content:"";position:absolute;left:0;top:.62em;width:7px;height:7px;border-radius:50%;background:var(--teal)}
@keyframes panel-in{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}
.badge8{display:inline-flex;align-items:center;gap:10px;margin-top:8px;padding:10px 16px;
  border-radius:100px;background:var(--teal-05);border:1.5px solid var(--teal-2);
  font:400 11px/1 var(--mono);letter-spacing:.14em;text-transform:uppercase;color:var(--teal-7)}

/* ═══════════ VERTICALS ═══════════ */
.band{background:var(--mist)}
.vhead{display:flex;justify-content:space-between;align-items:flex-end;gap:32px;flex-wrap:wrap}
.vg{display:grid;grid-template-columns:repeat(3,1fr);gap:clamp(14px,1.4vw,20px);margin-top:44px}
.vc{position:relative;background:var(--white);border:1.5px solid var(--n16);border-radius:18px;
  padding:26px 26px 28px;transition:transform .22s,box-shadow .22s,border-color .22s}
.vc:hover{transform:translateY(-4px);border-color:var(--navy);box-shadow:0 8px 0 var(--teal-1)}
.vc .no{position:absolute;top:22px;right:24px;font:400 10px/1 var(--mono);letter-spacing:.16em;
  color:var(--n40)}
.vc figure{margin:0 0 20px;width:74px}
.vc figure svg{width:74px;height:74px}
.vc h3{margin:0 0 9px;font-size:clamp(18px,1.4vw,20.5px);letter-spacing:-.008em;max-width:20ch}
.vc p{margin:0;font-size:14.5px;line-height:1.62;color:var(--n72)}
.vc-cta{background:var(--navy);border-color:var(--navy);display:flex;flex-direction:column;
  justify-content:center}
.vc-cta:hover{box-shadow:0 8px 0 var(--teal)}
.vc-cta h3{color:#fff}
.vc-cta p{color:rgba(255,255,255,.72)}
.vc-cta .btn{align-self:flex-start;margin-top:22px;padding:13px 22px;font-size:13.5px}

/* ═══════════ OBJECTIVES ═══════════ */
.obj{display:grid;grid-template-columns:.85fr 1.15fr;gap:clamp(30px,5vw,72px);align-items:start}
.obj-l{position:sticky;top:calc(var(--head) + 26px)}
.acc{border-top:2px solid var(--navy)}
.ai{border-bottom:1.5px solid var(--n16)}
.ai:last-child{border-bottom:2px solid var(--navy)}
.ah{display:grid;grid-template-columns:auto 1fr auto;gap:18px;align-items:center;width:100%;
  background:none;border:0;cursor:pointer;padding:22px 4px;text-align:left;font:inherit;color:inherit;
  transition:padding-left .2s}
.ah:hover{padding-left:12px}
.ah .n{display:grid;place-items:center;width:34px;height:34px;border-radius:50%;background:var(--teal-05);
  border:1.5px solid var(--teal-2);font:400 12px/1 var(--mono);color:var(--teal-7);transition:.2s}
.ai.on .ah .n{background:var(--teal);border-color:var(--teal);color:#fff}
.ah h3{margin:0}
.ah .pm{width:22px;height:22px;position:relative;flex:none}
.ah .pm::before,.ah .pm::after{content:"";position:absolute;background:var(--navy);border-radius:2px;
  transition:transform .25s,opacity .25s}
.ah .pm::before{inset:10px 0 10px 0;height:2px}
.ah .pm::after{inset:0 10px 0 10px;width:2px}
.ai.on .ah .pm::after{transform:scaleY(0);opacity:0}
.ap{max-height:0;overflow:hidden;transition:max-height .4s cubic-bezier(.4,0,.2,1)}
.ap ul{list-style:none;margin:0;padding:0 0 26px 52px}
.ap li{display:grid;grid-template-columns:auto 1fr;gap:14px;align-items:start;padding:9px 0;
  font-size:15.5px;color:var(--n72);line-height:1.6}
.ap li svg{margin-top:6px;flex:none}

/* ═══════════ APP ═══════════ */
.app-grid{display:grid;grid-template-columns:1.05fr .95fr;gap:clamp(30px,5vw,72px);align-items:center}
.app-art-new{margin:0;display:flex;align-items:center;justify-content:center}
.app-art-new img{display:block;width:100%;height:auto;max-width:540px}
.app-art-old{display:none}
.qr-row{display:grid;grid-template-columns:1fr 1fr;gap:clamp(14px,1.6vw,20px);margin-top:32px;max-width:430px}
.qr{border:2px solid var(--navy);border-radius:var(--r);background:var(--white);padding:18px 18px 16px;
  display:flex;flex-direction:column;align-items:center;gap:12px;color:inherit;text-decoration:none;cursor:pointer;
  transition:transform .2s,box-shadow .2s}
.qr:hover{transform:translateY(-4px);box-shadow:0 8px 0 var(--teal)}
.qr .store{font:500 11px/1 var(--mono);letter-spacing:.16em;text-transform:uppercase}
.qr-slot{width:100%;aspect-ratio:1/1;background:#fff;border:1.5px dashed var(--n16);border-radius:8px}
.qr-slot img{width:100%;height:100%;object-fit:contain;display:block}
.qr .qr-sub{font-size:12.5px;color:var(--n40)}
.qr .qr-download{font:600 10px/1 var(--mono);letter-spacing:.1em;text-transform:uppercase;color:var(--teal)}
.qr-note{margin:20px 0 0;font:400 12.5px/1.6 var(--mono);color:var(--n40)}

/* ═══════════ JOIN ═══════════ */
.jg{display:grid;grid-template-columns:repeat(3,1fr);gap:clamp(16px,1.8vw,24px);margin-top:50px}
.jc{border:2px solid var(--navy);border-radius:var(--r);background:var(--white);padding:clamp(24px,2.4vw,32px);
  display:flex;flex-direction:column;transition:transform .22s,box-shadow .22s}
.jc:hover{transform:translateY(-5px);box-shadow:0 10px 0 var(--navy)}
.jc svg{width:56px;height:56px;margin-bottom:22px}
.jc .lab{font:400 10.5px/1 var(--mono);letter-spacing:.16em;text-transform:uppercase;color:var(--teal-7);
  margin-bottom:12px}
.jc h3{margin-bottom:10px}
.jc p{margin:0;font-size:15px;color:var(--n72)}

/* ═══════════ FINAL ═══════════ */
.fin{background:var(--teal);color:#fff;text-align:center;position:relative;overflow:hidden}
.fin .h2{color:#fff;font-size:clamp(36px,5.2vw,74px);line-height:1.04;max-width:16ch;margin-inline:auto}
.fin .h2 em{color:var(--navy);font-style:italic}
.fin p{color:rgba(255,255,255,.86);max-width:56ch;margin:24px auto 0}
.fin .bcz{font:italic 400 clamp(21px,2.4vw,32px)/1.3 var(--dsp);margin-top:30px}
.fin .blob{position:absolute;pointer-events:none;opacity:.16}

/* ═══════════ FOOTER ═══════════ */
.foot{background:var(--navy);color:#fff;padding:clamp(56px,6vw,84px) 0 32px}
.fg{display:grid;grid-template-columns:1.5fr 1fr 1fr;gap:clamp(26px,4vw,56px)}
.foot .logo{display:inline-flex;width:220px;aspect-ratio:1056/430;overflow:hidden;align-items:flex-start}
.foot .logo-img{display:block;width:100%;height:auto;filter:brightness(0) invert(1);opacity:.95}
.ftag{font:italic 400 20px/1.35 var(--dsp);color:var(--teal-3);margin:18px 0 0}
.fdesc{font-size:14.5px;color:rgba(255,255,255,.62);margin:14px 0 0;max-width:34ch}
.foot h4{font:400 10.5px/1 var(--mono);letter-spacing:.2em;text-transform:uppercase;color:var(--teal-3);
  margin-bottom:20px}
.foot ul{list-style:none;margin:0;padding:0}
.foot li{margin-bottom:12px}
.foot a{font-size:14.5px;color:rgba(255,255,255,.8);text-decoration:none;transition:color .16s}
.foot a:hover{color:var(--teal-3)}
.flegal{margin-top:clamp(40px,5vw,64px);padding-top:26px;border-top:1px solid rgba(255,255,255,.16);
  display:flex;flex-wrap:wrap;gap:10px 28px;justify-content:space-between;
  font:400 12px/1.7 var(--mono);color:rgba(255,255,255,.5)}

.top{position:fixed;right:22px;bottom:22px;z-index:140;width:50px;height:50px;border-radius:50%;
  background:var(--navy);color:#fff;border:2px solid #fff;display:grid;place-items:center;cursor:pointer;
  opacity:0;transform:translateY(14px);pointer-events:none;transition:.3s}
.top.show{opacity:1;transform:none;pointer-events:auto}
.top:hover{background:var(--teal)}

/* ═══════════ MOTION ═══════════ */
.rv{opacity:0;transform:translateY(26px);transition:opacity .75s cubic-bezier(.2,.7,.3,1),transform .75s cubic-bezier(.2,.7,.3,1)}
.rv.in{opacity:1;transform:none}
.anim{opacity:0;transform:translateY(22px);animation:rise .85s cubic-bezier(.2,.7,.3,1) forwards}
@keyframes rise{to{opacity:1;transform:none}}
.d1{animation-delay:.05s}.d2{animation-delay:.18s}.d3{animation-delay:.31s}.d4{animation-delay:.44s}.d5{animation-delay:.58s}
.al{opacity:0;animation:rise .95s cubic-bezier(.2,.7,.3,1) forwards}
.a1{animation-delay:.2s}.a2{animation-delay:.4s}.a3{animation-delay:.6s}.a4{animation-delay:.8s}
.spin{animation:spin 90s linear infinite;transform-origin:center}
@keyframes spin{to{transform:rotate(360deg)}}
.bob{animation:bob 5s ease-in-out infinite}
.bob2{animation:bob 5s ease-in-out 1.4s infinite}
.bob3{animation:bob 5s ease-in-out 2.6s infinite}
@keyframes bob{0%,100%{transform:translateY(0)}50%{transform:translateY(-10px)}}
:focus-visible{outline:3px solid var(--teal);outline-offset:3px;border-radius:4px}


/* ══ hero panorama ══ */
.plx{will-change:transform}
#sunring{transform-origin:940px 168px;animation:spin 80s linear infinite}
.smoke{animation:puff 7s ease-in-out infinite}
.smoke2{animation:puff 7s ease-in-out 1.1s infinite}
@keyframes puff{0%,100%{transform:translate(0,0);opacity:.7}50%{transform:translate(7px,-13px);opacity:.32}}
#truck{animation:drive 22s linear infinite}
@keyframes drive{from{transform:translateX(-260px)}to{transform:translateX(1300px)}}
#birds{animation:fly 26s linear infinite}
@keyframes fly{from{transform:translate(-140px,18px)}to{transform:translate(1320px,-34px)}}
.al.a1{animation-delay:.2s}.al.a2{animation-delay:.4s}.al.a3{animation-delay:.6s}
.al.a4{animation-delay:.8s}.al.a5{animation-delay:1s}.al.a6{animation-delay:1.2s}

/* ═══════════ RESPONSIVE ═══════════ */
@media(max-width:1040px){
  :root{--head:176px}
  .hg,.ab,.obj,.app-grid{grid-template-columns:1fr}
  .hg>div:last-child{margin-right:0}
  .ab-l,.obj-l{position:static}
  .vg,.jg{grid-template-columns:repeat(2,1fr)}
  .hcta,.site-switch{display:none}
  .mobile-actions{position:relative;z-index:2;display:grid;grid-template-columns:1fr 1fr;gap:10px;padding:5px 0 11px;background:var(--paper)}
  .mobile-actions .btn{width:100%;min-height:46px;justify-content:center;overflow:hidden;padding:11px 9px;font-size:12.5px;white-space:nowrap;text-overflow:ellipsis}
  .fg{grid-template-columns:1fr 1fr}
}
@media(max-width:660px){
  body{font-size:16px}
  .head .logo{left:18px;top:8px;width:145px;height:60px}
  .foot .logo{width:200px}
  .vg,.jg,.fg{grid-template-columns:1fr}
  .qr-row{grid-template-columns:1fr;max-width:290px;margin-inline:auto}
  .hero .l1{font-size:clamp(44px,13vw,72px)}
  .ap ul{padding-left:0}
}
@media(prefers-reduced-motion:reduce){
