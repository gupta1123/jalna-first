<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="description" content="Jalna First Citizen Forum brings citizens, businesses, institutions and authorities together for civic awareness, collaboration and positive action in Jalna.">
<meta name="theme-color" content="#EFE5D2">
<link rel="icon" type="image/png" href="/jalna-first-logo.png">
<link rel="apple-touch-icon" href="/jalna-first-logo.png">
<title>Jalna First Citizen Forum — Change Begins With Action</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Hanken+Grotesk:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&family=Tiro+Devanagari+Marathi:ital@0;1&display=swap" rel="stylesheet">

<style is:global>
/* ═══════════════ TOKENS ═══════════════ */
:root{
  --paper:      #EFE5D2;   /* beige base */
  --paper-lift: #F7F1E4;   /* card paper */
  --paper-deep: #E3D5BA;   /* banded beige */
  --ink:        #0E2233;   /* deep navy ink */
  --teal:       #0F6E68;
  --teal-deep:  #073633;
  --marigold:   #E8912A;
  --leaf:       #78933C;   /* mosambi orchard green */

  --ink-72: rgba(14,34,51,.72);
  --ink-48: rgba(14,34,51,.48);
  --ink-16: rgba(14,34,51,.16);
  --ink-08: rgba(14,34,51,.08);

  --dsp:  "Instrument Serif",Georgia,"Times New Roman",serif;
  --body: "Hanken Grotesk","Helvetica Neue",Arial,sans-serif;
  --mono: "JetBrains Mono",ui-monospace,Menlo,monospace;
  --deva: "Tiro Devanagari Marathi","Hanken Grotesk",serif;

  --wrap: min(1220px, 90vw);
  --pad:  clamp(80px, 10vw, 148px);
  --head: 132px;
}

*,*::before,*::after{ box-sizing:border-box }
html{ -webkit-text-size-adjust:100%; scroll-behavior:smooth }
body{
  margin:0; background:var(--paper); color:var(--ink);
  font:400 17px/1.72 var(--body); -webkit-font-smoothing:antialiased; overflow-x:hidden;
}
svg,img{ display:block; max-width:100% }
a{ color:inherit }
section[id]{ scroll-margin-top:var(--head) }

.grain{ position:fixed; inset:0; z-index:9999; pointer-events:none; opacity:.09; mix-blend-mode:multiply }

/* ═══════════════ TYPE ═══════════════ */
h1,h2,h3,h4{ margin:0 }
.h2{ font:400 clamp(34px,4.4vw,62px)/1.04 var(--dsp); letter-spacing:-.018em }
.h2 em{ font-style:italic; color:var(--teal) }
.h3{ font:400 clamp(21px,1.8vw,26px)/1.2 var(--dsp); letter-spacing:-.012em }
.lede{ font-size:clamp(16px,1.15vw,18px); color:var(--ink-72); max-width:58ch }
.marathi{ font-family:var(--deva); font-weight:400; line-height:1.65 }

.tag{
  display:inline-flex; align-items:center; gap:12px;
  font:400 11px/1 var(--mono); letter-spacing:.18em; text-transform:uppercase; color:var(--teal);
}
.tag i{ font-style:normal; color:var(--marigold) }
.tag::before{ content:""; width:38px; height:1.5px; background:var(--marigold); order:-1 }
.tag.inv{ color:var(--marigold) }
.tag.inv::before{ background:rgba(239,229,210,.45) }

/* ═══════════════ LAYOUT ═══════════════ */
.wrap{ width:var(--wrap); margin-inline:auto }
.sec{ padding-block:var(--pad); position:relative }

/* ═══════════════ BUTTONS ═══════════════ */
.btn{
  display:inline-flex; align-items:center; gap:10px; cursor:pointer; text-decoration:none;
  font:700 14.5px/1 var(--body); letter-spacing:.015em; padding:16px 27px; border-radius:100px;
  border:2px solid var(--ink); transition:transform .18s, box-shadow .18s, background .18s, color .18s;
}
.btn svg{ transition:transform .18s }
.btn:hover svg{ transform:translateX(4px) }
.b-teal{ background:var(--teal); border-color:var(--teal); color:var(--paper); box-shadow:4px 4px 0 var(--ink) }
.b-teal:hover{ transform:translate(-2px,-2px); box-shadow:7px 7px 0 var(--ink) }
.b-gold{ background:var(--marigold); color:var(--ink); box-shadow:4px 4px 0 var(--ink) }
.b-gold:hover{ transform:translate(-2px,-2px); box-shadow:7px 7px 0 var(--ink) }
.b-line{ background:transparent; color:var(--ink) }
.b-line:hover{ background:var(--ink); color:var(--paper) }
.b-paper{ background:var(--paper); border-color:var(--paper); color:var(--ink) }
.b-paper:hover{ transform:translateY(-3px) }
.b-linep{ background:transparent; border-color:rgba(239,229,210,.5); color:var(--paper) }
.b-linep:hover{ background:var(--paper); border-color:var(--paper); color:var(--ink) }

/* ═══════════════ HEADER + SECTION RAIL ═══════════════ */
.prog{ position:fixed; top:0; left:0; height:3px; background:var(--marigold); z-index:200; width:0 }
.head{ position:sticky; top:0; z-index:150; background:var(--paper) }
.head-top{ display:flex; align-items:center; gap:24px; height:74px }
.logo{ display:flex; align-items:center; gap:12px; text-decoration:none; margin-right:auto }
.logo-mark{
  width:42px; height:42px; flex:none; position:relative; overflow:hidden; border-radius:50%;
  background:var(--paper-lift); box-shadow:0 0 0 1px rgba(15,110,104,.2);
}
.logo-mark img{
  position:absolute; width:132%; max-width:none; height:auto; left:50%; top:50%;
  transform:translate(-52.1%,-42.5%);
}
.logo b{ font:400 23px/1 var(--dsp); display:block; letter-spacing:-.015em }
.logo small{ display:block; font:500 8.5px/1 var(--mono); letter-spacing:.22em; color:var(--teal); text-transform:uppercase; margin-top:4px }
.invest-link,.ig-link{
  flex:none; text-decoration:none; padding:10px 15px; border:1.5px solid var(--ink-16); border-radius:100px;
  font:600 12px/1 var(--body); color:var(--ink-72); transition:background .18s,color .18s,border-color .18s;
}
.invest-link:hover,.ig-link:hover{ background:var(--ink); border-color:var(--ink); color:var(--paper) }
.ig-link{ color:var(--teal); border-color:rgba(15,110,104,.34) }
.head-cta{ padding:12px 21px; font-size:13.5px; box-shadow:3px 3px 0 var(--ink) }

.rail-wrap{ border-top:1px solid var(--ink-16); border-bottom:1px solid var(--ink-16); background:var(--paper) }
.rail{
  position:relative; display:flex; gap:4px; overflow-x:auto; scrollbar-width:none;
  padding:9px 0; -webkit-overflow-scrolling:touch;
}
.rail::-webkit-scrollbar{ display:none }
.rail a{
  position:relative; z-index:2; flex:none; text-decoration:none; padding:9px 17px; border-radius:100px;
  font:600 13.5px/1 var(--body); color:var(--ink-48); white-space:nowrap;
  display:flex; align-items:center; gap:9px; transition:color .28s;
}
.rail a em{ font:400 10.5px/1 var(--mono); font-style:normal; opacity:.6 }
.rail a:hover{ color:var(--ink) }
.rail a.on{ color:var(--paper) }
.rail a.on em{ opacity:.75 }
.rail-ind{
  position:absolute; z-index:1; top:9px; left:0; height:34px; border-radius:100px; background:var(--teal);
  transition:transform .42s cubic-bezier(.65,.05,.15,1), width .42s cubic-bezier(.65,.05,.15,1);
  will-change:transform,width;
}

/* ═══════════════ HERO ═══════════════ */
.hero{ padding-top:clamp(40px,5vw,72px); padding-bottom:0; overflow:hidden }
.hero-grid{ display:grid; grid-template-columns:1.02fr .98fr; gap:clamp(24px,3.5vw,56px); align-items:center }
.hero h1{ margin:24px 0 0; font-family:var(--dsp); font-weight:400; letter-spacing:-.022em }
.hero .l1{ display:block; font-size:clamp(50px,7.1vw,102px); line-height:.98 }
.hero .l2{ display:block; font-size:clamp(30px,3.9vw,56px); line-height:1.1; color:var(--teal); letter-spacing:-.02em; margin-top:6px }
.hero .l2 em{ font-style:italic; position:relative; z-index:1; padding-right:.04em }
.hero .l2 em::after{
  content:""; position:absolute; z-index:-1; inset:auto 0 .08em 0; height:.2em; background:var(--marigold);
  opacity:.6; transform:scaleX(0); transform-origin:left; animation:swipe .75s cubic-bezier(.2,.75,.3,1) 1.15s forwards;
}
@keyframes swipe{ to{ transform:scaleX(1) } }
.hero p{ margin:24px 0 0 }
.hero-cta{ display:flex; flex-wrap:wrap; gap:13px; margin-top:34px }
.hero-mr{ margin-top:40px; padding-left:20px; border-left:3px solid var(--marigold); font-size:clamp(17px,1.5vw,20px); max-width:36ch }
.hero-mr b{ color:var(--teal); font-weight:400; font-style:italic }
.hero-art{ position:relative }
.plx{ will-change:transform }

/* ═══════════════ MARQUEE ═══════════════ */
.marq{ background:var(--ink); color:var(--paper); overflow:hidden; border-block:2px solid var(--ink) }
.marq-in{ display:flex; width:max-content; animation:slide 42s linear infinite }
.marq span{
  display:flex; align-items:center; gap:34px; padding:0 17px;
  font:400 12px/1 var(--mono); letter-spacing:.16em; text-transform:uppercase; height:52px; white-space:nowrap;
}
.marq span::after{ content:""; width:5px; height:5px; border-radius:50%; background:var(--marigold); flex:none }
.marq .mr{ font-family:var(--deva); letter-spacing:.02em; color:var(--marigold); text-transform:none; font-size:17px }
@keyframes slide{ to{ transform:translateX(-50%) } }

/* ═══════════════ ABOUT ═══════════════ */
.ab{ display:grid; grid-template-columns:1fr 1.08fr; gap:clamp(30px,5vw,84px); align-items:start }
.ab-l{ position:sticky; top:calc(var(--head) + 28px) }
.ab-b p{ margin:0 0 20px; color:var(--ink-72); font-size:17.5px }
.ab-b p.first{ font-size:21px; color:var(--ink); font-weight:500; line-height:1.45 }
.chips{ display:flex; flex-wrap:wrap; gap:8px; margin-top:32px }
.chip{
  font:600 13px/1 var(--body); padding:9px 16px; border-radius:100px;
  border:1.5px solid var(--ink-16); background:var(--paper-lift); display:flex; align-items:center; gap:8px;
}
.chip i{ width:7px; height:7px; border-radius:50%; flex:none; font-style:normal }

/* ═══════════════ FLOW ═══════════════ */
.band{ background:var(--paper-deep) }
.flow-head{ display:flex; justify-content:space-between; align-items:flex-end; gap:32px; flex-wrap:wrap; margin-bottom:56px }
.flow{ display:grid; grid-template-columns:repeat(4,1fr); gap:clamp(16px,2vw,28px) }
.stepc{
  background:var(--paper-lift); border:2px solid var(--ink); border-radius:6px; padding:0 0 26px;
  overflow:hidden; transition:transform .22s, box-shadow .22s;
}
.stepc:hover{ transform:translate(-3px,-4px); box-shadow:8px 9px 0 var(--teal) }
.stepc figure{ margin:0; background:var(--paper); border-bottom:2px solid var(--ink) }
.stepc .txt{ padding:22px clamp(18px,1.8vw,26px) 0 }
.stepc .lab{ font:500 10.5px/1 var(--mono); letter-spacing:.18em; text-transform:uppercase; color:var(--teal); display:block; margin-bottom:8px }
.stepc h3{ margin-bottom:10px }
.stepc p{ margin:0; font-size:15px; color:var(--ink-72) }

/* ═══════════════ FOCUS ═══════════════ */
.fg{ display:grid; grid-template-columns:repeat(3,1fr); gap:clamp(16px,1.8vw,24px); margin-top:56px }
.fc{
  border:2px solid var(--ink); border-radius:6px; overflow:hidden; background:var(--paper-lift);
  display:flex; flex-direction:column; transition:transform .22s, box-shadow .22s;
}
.fc:hover{ transform:translate(-3px,-4px); box-shadow:8px 9px 0 var(--marigold) }
.fc figure{ margin:0; border-bottom:2px solid var(--ink); position:relative }
.fc .no{
  position:absolute; top:12px; left:14px; font:500 10.5px/1 var(--mono);
  letter-spacing:.14em; color:var(--ink-48);
}
.fc .txt{ padding:24px clamp(20px,2vw,28px) 28px }
.fc h3{ margin-bottom:11px }
.fc p{ margin:0; font-size:15px; color:var(--ink-72) }
.sky-a{ background:#DCE9E4 } .sky-b{ background:#F0E0C4 } .sky-c{ background:#E2EBD6 }

/* ═══════════════ WORK ═══════════════ */
.work{ background:var(--teal-deep); color:var(--paper) }
.work .h2, .work .lede{ color:var(--paper) }
.work .h2 em{ color:var(--marigold) }
.work .lede{ color:rgba(239,229,210,.72) }
.wk{ display:grid; grid-template-columns:.82fr 1.18fr; gap:clamp(30px,5vw,76px); align-items:start }
.wk ul{ list-style:none; margin:0; padding:0 }
.wk li{
  display:grid; grid-template-columns:auto 1fr; gap:18px; align-items:center;
  padding:18px 0; border-top:1px solid rgba(239,229,210,.16); font-size:16.5px;
  transition:padding-left .22s;
}
.wk li:hover{ padding-left:8px }
.wk li:last-child{ border-bottom:1px solid rgba(239,229,210,.16) }
.wk li svg{ flex:none }

/* ═══════════════ ORBIT / TOGETHER ═══════════════ */
.tg{ display:grid; grid-template-columns:1fr 1fr; gap:clamp(34px,5vw,76px); align-items:center }
.quote{
  font:italic 400 clamp(26px,2.9vw,40px)/1.2 var(--dsp); letter-spacing:-.015em; margin:36px 0 0;
  border-left:4px solid var(--marigold); padding-left:clamp(20px,2.4vw,32px);
}
.quote cite{ display:block; font:500 11.5px/1 var(--mono); letter-spacing:.18em; text-transform:uppercase; color:var(--teal); font-style:normal; margin-top:20px }
.orbit-r{ animation:spin 90s linear infinite; transform-origin:300px 300px }
.orbit-r2{ animation:spin 70s linear infinite reverse; transform-origin:300px 300px }
@keyframes spin{ to{ transform:rotate(360deg) } }

/* ═══════════════ VISION ═══════════════ */
.vis{ background:var(--ink); color:var(--paper); overflow:hidden; text-align:center }
.vis .h2{ color:var(--paper); max-width:18ch; margin-inline:auto }
.vis .h2 em{ color:var(--marigold) }
.vis p{ color:rgba(239,229,210,.7); max-width:64ch; margin:26px auto 0 }
.vis .tag{ justify-content:center }
.vis-art{ margin:56px auto 0 }
.draw{ stroke-dasharray:1400; stroke-dashoffset:1400; transition:stroke-dashoffset 2.4s ease .2s }
.in .draw{ stroke-dashoffset:0 }

/* ═══════════════ JOIN ═══════════════ */
.ig{ display:grid; grid-template-columns:repeat(3,1fr); gap:clamp(16px,1.8vw,24px); margin-top:54px }
.ic{
  border:2px solid var(--ink); border-radius:6px; background:var(--paper-lift); overflow:hidden;
  display:flex; flex-direction:column; transition:transform .22s, box-shadow .22s;
}
.ic:hover{ transform:translate(-3px,-4px); box-shadow:8px 9px 0 var(--leaf) }
.ic figure{ margin:0; padding:26px 26px 0 }
.ic .txt{ padding:14px clamp(20px,2vw,28px) 30px }
.ic .lab{ font:500 10.5px/1 var(--mono); letter-spacing:.16em; text-transform:uppercase; color:var(--teal); display:block; margin-bottom:12px }
.ic h3{ margin-bottom:10px }
.ic p{ margin:0; font-size:15px; color:var(--ink-72) }
.ic-cta{ display:flex; flex-wrap:wrap; gap:14px; margin-top:46px }

/* ═══════════════ FINAL ═══════════════ */
.fin{ background:var(--teal); color:var(--paper); text-align:center; position:relative; overflow:hidden }
.fin .h2{ color:var(--paper); font-size:clamp(38px,5.4vw,76px); line-height:1.02; max-width:16ch; margin-inline:auto }
.fin .h2 em{ color:var(--marigold) }
.fin p{ color:rgba(239,229,210,.82); max-width:58ch; margin:26px auto 0 }
.fin .bcz{ font:italic 400 clamp(23px,2.5vw,34px)/1.2 var(--dsp); letter-spacing:-.015em; color:var(--marigold); margin-top:32px }
.fin-cta{ display:flex; flex-wrap:wrap; gap:14px; justify-content:center; margin-top:38px }
.blob{ position:absolute; pointer-events:none; opacity:.12 }

/* ═══════════════ FOOTER ═══════════════ */
.foot{ background:var(--ink); color:var(--paper); padding:clamp(58px,6vw,86px) 0 34px }
.fgrid{ display:grid; grid-template-columns:1.5fr 1fr 1fr; gap:clamp(28px,4vw,60px) }
.foot .logo b{ color:var(--paper); font-size:26px }
.foot .logo small{ color:var(--marigold) }
.foot h4{ font:500 11px/1 var(--mono); letter-spacing:.2em; text-transform:uppercase; color:var(--marigold); margin-bottom:20px }
.foot ul{ list-style:none; margin:0; padding:0 }
.foot li{ margin-bottom:12px }
.foot a{ font-size:14.5px; color:rgba(239,229,210,.76); text-decoration:none; transition:color .16s }
.foot a:hover{ color:var(--marigold) }
.ftag{ font:italic 400 21px/1.3 var(--dsp); letter-spacing:-.01em; color:var(--marigold); margin:16px 0 0 }
.fdesc{ font-size:14.5px; color:rgba(239,229,210,.58); margin:14px 0 0; max-width:34ch }
.flegal{
  margin-top:clamp(42px,5vw,66px); padding-top:26px; border-top:1px solid rgba(239,229,210,.14);
  display:flex; flex-wrap:wrap; gap:10px 28px; justify-content:space-between;
  font:400 12.5px/1.6 var(--mono); color:rgba(239,229,210,.45);
}

/* ═══════════════ TOP BUTTON ═══════════════ */
.top{
  position:fixed; right:22px; bottom:22px; z-index:140; width:50px; height:50px; border-radius:50%;
  background:var(--ink); color:var(--paper); border:2px solid var(--paper); display:grid; place-items:center;
  cursor:pointer; opacity:0; transform:translateY(14px); pointer-events:none;
  transition:opacity .3s, transform .3s, background .2s;
}
.top.show{ opacity:1; transform:none; pointer-events:auto }
.top:hover{ background:var(--teal) }

/* ═══════════════ MOTION ═══════════════ */
.rv{ opacity:0; transform:translateY(26px); transition:opacity .75s cubic-bezier(.2,.7,.3,1), transform .75s cubic-bezier(.2,.7,.3,1) }
.rv.in{ opacity:1; transform:none }
.anim{ opacity:0; transform:translateY(22px); animation:rise .85s cubic-bezier(.2,.7,.3,1) forwards }
@keyframes rise{ to{ opacity:1; transform:none } }
.d1{animation-delay:.05s}.d2{animation-delay:.18s}.d3{animation-delay:.31s}.d4{animation-delay:.44s}.d5{animation-delay:.58s}
.al{ opacity:0; animation:rise .95s cubic-bezier(.2,.7,.3,1) forwards }
.l1d{animation-delay:.18s}.l2d{animation-delay:.36s}.l3d{animation-delay:.54s}.l4d{animation-delay:.72s}
#sunring{ transform-origin:940px 168px; animation:spin 80s linear infinite }
.smoke{ animation:puff 7s ease-in-out infinite }
.smoke2{ animation:puff 7s ease-in-out 1.1s infinite }
@keyframes puff{ 0%,100%{ transform:translate(0,0); opacity:.7 } 50%{ transform:translate(7px,-13px); opacity:.32 } }
#truck{ animation:drive 22s linear infinite }
@keyframes drive{ from{ transform:translateX(-260px) } to{ transform:translateX(1300px) } }
#birds{ animation:fly 26s linear infinite }
@keyframes fly{ from{ transform:translate(-140px,18px) } to{ transform:translate(1320px,-34px) } }
.bob{ animation:bob 4.5s ease-in-out infinite }
@keyframes bob{ 0%,100%{ transform:translateY(0) } 50%{ transform:translateY(-7px) } }

:focus-visible{ outline:3px solid var(--marigold); outline-offset:3px; border-radius:4px }

/* ═══════════════ RESPONSIVE ═══════════════ */
@media (max-width:1040px){
  :root{ --head:126px }
  .hero-grid,.ab,.wk,.tg{ grid-template-columns:1fr }
  .ab-l{ position:static }
  .flow,.fg,.ig{ grid-template-columns:repeat(2,1fr) }
  .head-cta{ display:none }
  .fgrid{ grid-template-columns:1fr 1fr }
}
@media (max-width:640px){
  body{ font-size:16px }
  :root{ --head:122px }
  .flow,.fg,.ig,.fgrid{ grid-template-columns:1fr }
  .hero .l1{ font-size:clamp(48px,15vw,76px) }
  .btn{ padding:15px 23px }
  .rail{ padding:8px 0 }
  .invest-link{ display:none }
  .ig-link{ padding:9px 11px; font-size:10.5px }
}
@media (prefers-reduced-motion:reduce){
  *,*::before,*::after{ animation:none !important; transition-duration:.01ms !important }
  html{ scroll-behavior:auto }
  .rv,.anim,.al{ opacity:1; transform:none }
  .hero .l2 em::after{ transform:scaleX(1) }
  .draw{ stroke-dashoffset:0 }
}
</style>
</head>
<body>

<svg class="grain" aria-hidden="true">
  <filter id="gf"><feTurbulence type="fractalNoise" baseFrequency=".84" numOctaves="4" stitchTiles="stitch"/></filter>
  <rect width="100%" height="100%" filter="url(#gf)"/>
</svg>

<div class="prog" id="prog"></div>

<!-- ══════════════ HEADER ══════════════ -->
<header class="head">
  <div class="wrap head-top">
    <a class="logo" href="#home">
      <span class="logo-mark"><img src="/jalna-first-logo.png" width="42" height="42" alt="Jalna First Citizen Forum logo"></span>
      <span><b>Jalna First</b><small>Citizen Forum</small></span>
    </a>
    <a class="invest-link" href="/investment">Investment Summit ↗</a>
    <a class="ig-link" href="https://www.instagram.com/jalnafirstcf/" target="_blank" rel="noopener noreferrer">Instagram · @jalnafirstcf</a>
    <a class="btn b-teal head-cta" href="#join">Get involved</a>
  </div>
  <div class="rail-wrap">
    <nav class="wrap rail" id="rail" aria-label="Sections">
      <span class="rail-ind" id="ind" aria-hidden="true"></span>
      <a href="#home"  class="on"><em>01</em>Home</a>
      <a href="#about"><em>02</em>Who we are</a>
      <a href="#doing"><em>03</em>What we do</a>
      <a href="#focus"><em>04</em>Focus areas</a>
