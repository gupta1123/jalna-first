<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="description" content="Explore upcoming Jalna First events and initiatives in Jalna, Maharashtra.">
<meta name="theme-color" content="#093C54">
<link rel="icon" type="image/png" sizes="256x256" href="/JFfavicon.png">
<link rel="apple-touch-icon" href="/JFfavicon.png">
<title>Upcoming Events - Jalna First</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&display=swap" rel="stylesheet">

<style is:global>
:root{
  --navy:#093C54;--teal:#0DA1A7;--teal-soft:#D6EFF0;--paper:#F5FBFB;--white:#fff;
  --ink-soft:rgba(9,60,84,.72);--line:rgba(9,60,84,.16);
  --display:"Instrument Serif",Georgia,serif;--body:"Instrument Serif",Georgia,serif;
  --mono:"Instrument Serif",Georgia,serif;--wrap:min(1160px,90vw);
}
*,*::before,*::after{box-sizing:border-box}
html{-webkit-text-size-adjust:100%;scroll-behavior:smooth}
body{margin:0;background:var(--paper);color:var(--navy);font:400 17px/1.65 var(--body);-webkit-font-smoothing:antialiased}
img{display:block;max-width:100%}
a{color:inherit}
.wrap{width:var(--wrap);margin-inline:auto}
.header{position:relative;border-bottom:1px solid var(--line);background:rgba(245,251,251,.96)}
.header-inner{min-height:96px;display:flex;align-items:center;justify-content:space-between;gap:24px}
.brand{position:absolute;left:clamp(20px,2.6vw,52px);top:8px;width:185px;height:76px;display:block;overflow:hidden;contain:paint;background:url('/JFlogo.png') left top/100% auto no-repeat}
.brand img{display:none}
.back{display:inline-flex;align-items:center;gap:9px;margin-left:auto;padding:12px 18px;border:1.5px solid var(--line);border-radius:999px;text-decoration:none;font-size:14px;font-weight:600;transition:.18s}
.back:hover{border-color:var(--teal);transform:translateY(-2px)}
.hero{padding:clamp(44px,6vw,76px) 0 clamp(30px,4vw,44px)}
.eyebrow{margin:0;color:var(--teal);font:500 11px/1 var(--mono);letter-spacing:.2em;text-transform:uppercase}
h1{max-width:12ch;margin:16px 0 0;font:400 clamp(50px,6.8vw,82px)/.96 var(--display);letter-spacing:-.03em}
h1 em{color:var(--teal);font-style:italic}
.intro{max-width:62ch;margin:18px 0 0;color:var(--ink-soft);font-size:clamp(16px,1.35vw,18px)}
.events{padding:0 0 clamp(64px,7vw,92px)}
.event-card{position:relative;display:grid;grid-template-columns:280px 1fr;max-width:980px;margin-inline:auto;border:1.5px solid var(--navy);border-radius:16px;background:var(--white);overflow:hidden;text-decoration:none;box-shadow:7px 8px 0 var(--teal);transition:transform .2s,box-shadow .2s}
.event-card:hover{transform:translate(-3px,-3px);box-shadow:12px 13px 0 var(--teal)}
.event-visual{min-height:240px;padding:22px;display:flex;align-items:center;justify-content:center;background:linear-gradient(145deg,var(--teal-soft),var(--paper))}
.event-visual img{width:min(100%,245px);mix-blend-mode:multiply}
.event-copy{position:relative;padding:25px 30px;display:flex;flex-direction:column;justify-content:center}
.event-label{margin:0;color:var(--teal);font:500 11px/1 var(--mono);letter-spacing:.18em;text-transform:uppercase}
h2{margin:10px 0 0;font:400 clamp(32px,3.6vw,44px)/1 var(--display);letter-spacing:-.02em}
.event-desc{max-width:62ch;margin:11px 0 0;color:var(--ink-soft);font-size:14.5px;line-height:1.5}
.meta{display:grid;grid-template-columns:repeat(3,1fr);margin-top:14px;border:1px solid var(--line)}
.meta div{padding:10px 12px;border-right:1px solid var(--line)}
.meta div:last-child{border-right:0}
.meta span{display:block;color:rgba(9,60,84,.48);font:500 9px/1 var(--mono);letter-spacing:.16em;text-transform:uppercase}
.meta b{display:block;margin-top:6px;font:400 16px/1.2 var(--display)}
.view{position:absolute;top:24px;right:28px;display:inline-flex;align-items:center;gap:7px;color:var(--navy);font-size:12.5px;font-weight:700}
.view i{font-style:normal;color:var(--teal-soft)}
.footer{padding:32px 0;border-top:1px solid var(--line);color:var(--ink-soft);font-size:14px}
.footer .wrap{display:flex;justify-content:space-between;gap:20px;flex-wrap:wrap}
@media(max-width:760px){
  .header-inner{min-height:80px}.brand{left:18px;top:9px;width:150px;height:62px}
  .back{padding:10px 14px;font-size:13px}.hero{padding:40px 0 28px}
  .event-card{grid-template-columns:1fr;max-width:540px}.event-visual{min-height:155px;padding:20px}
  .event-visual img{width:min(100%,260px)}
  .event-copy{padding:22px 20px 24px}.view{position:static;align-self:flex-start;margin-top:14px;padding:8px 12px;border-radius:999px;background:var(--navy);color:#fff}
  .meta{grid-template-columns:1fr 1fr}.meta div{padding:10px;border-bottom:0}.meta div:nth-child(2){border-right:0}.meta div:last-child{grid-column:1 / -1;border-top:1px solid var(--line)}
}
</style>
</head>
<body>
<header class="header">
  <div class="wrap header-inner">
    <a class="brand" href="/" aria-label="Jalna First home"><img src="/JFlogo.png" alt="Jalna First"></a>
    <a class="back" href="/">← Jalna First</a>
  </div>
</header>

<main>
  <section class="hero">
    <div class="wrap">
      <p class="eyebrow">Jalna First initiatives</p>
      <h1>Upcoming <em>events</em>.</h1>
      <p class="intro">Explore upcoming forums and initiatives designed to connect Jalna's citizens, industries, institutions and decision-makers around the city's next phase of growth.</p>
    </div>
  </section>

  <section class="events" aria-label="Upcoming events">
    <div class="wrap">
      <a class="event-card" href="/industrial-summit/" aria-label="View Jalna Industrial Summit 2026">
        <div class="event-visual">
          <img src="/industrial-summit/industrial-summit-logo (1).png" alt="Industrial Summit 2026 — A Jalna First Initiative">
        </div>
        <div class="event-copy">
          <p class="event-label">Upcoming · Industrial growth</p>
          <h2>Jalna Industrial Summit 2026</h2>
          <p class="event-desc">A focused platform built around Jalna's established steel, seed and feed economy, its Multi-Modal Logistics Park, investor tailwinds and the next opportunities in manufacturing.</p>
          <div class="meta" aria-label="Event details">
            <div><span>Date</span><b>3 September 2026</b></div>
            <div><span>Time</span><b>9:00 AM - 3:00 PM</b></div>
            <div><span>Venue</span><b>The Fern Hotel, Jalna</b></div>
          </div>
          <span class="view">View event <i>→</i></span>
        </div>
      </a>
    </div>
  </section>
</main>

<footer class="footer">
  <div class="wrap"><span>Jalna First Citizen Forum</span><span>Jalna, Maharashtra</span></div>
</footer>
</body>
</html>
